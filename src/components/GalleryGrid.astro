---
import { ui } from '../lib/ui';
import { getLocale } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = ui(locale);

import Icon from './Icon.astro';
import LoadMore from './LoadMore.astro';
import { listBatchSize } from '../scripts/infinite-list';
import './gallery-grid.css';
import { photos } from '../lib/photos';

interface GalleryImage { src: string; alt: string; }
interface Props { images: GalleryImage[]; }
const images = Astro.props.images.map(image=>{const photo=photos.find(p=>p.file===image.src);return {...image,photographer:photo?.author||'',source:photo?.source||'/fotograf-kaynaklari',license:photo?.license||''};});
const galleryId = "datca-gallery";
---

{images.length > 0 && <section class="gallery-grid-section" data-gallery aria-label={t("Fotoğraf galerisi")}>
  <header class="gallery-grid-header"><span><Icon name="grid" size={16} /> {t("FOTOĞRAF GALERİSİ")}</span><span>{t("{n} kare", {n:images.length})} <span aria-hidden="true">·</span> {t("Bir fotoğrafa dokun, yakından keşfet")}</span></header>
  <div class="gallery-photo-grid" id="gallery-photos" data-infinite-grid>{images.map((image, index) => <button type="button" class:list={['gallery-photo', { 'gallery-photo-lead': index === 0, 'gallery-photo-tall': index > 0 && index % 9 === 7 }]} data-gallery-index={index} data-deferred={index >= listBatchSize || undefined} aria-label={t("{n}. fotoğrafı büyüt: {alt}", {n:index+1,alt:image.alt})} aria-haspopup="dialog"><img src={image.src.replace('.webp','-640.webp')} alt={image.alt || `${t('Datça fotoğrafı')} ${index+1}`} loading="lazy" decoding="async" sizes="(max-width: 560px) 50vw, (max-width: 800px) 50vw, 33vw" /><span class="gallery-photo-shade" aria-hidden="true"></span><span class="gallery-photo-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="gallery-photo-expand" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5" /></svg></span></button>)}</div>
  <LoadMore controls="gallery-photos"/>
  <dialog class="gallery-lightbox" aria-labelledby={`${galleryId}-caption`} aria-describedby={`${galleryId}-status`}>
    <div class="gallery-dialog-shell">
      <header class="gallery-dialog-header"><span><Icon name="waves" size={18} /><span>{t("DATÇA, KARE KARE")}</span></span><button type="button" class="gallery-dialog-close" data-gallery-close aria-label={t("Fotoğrafı kapat")}><Icon name="close" size={24} /></button></header>
      <div class="gallery-lightbox-stage">
        <button type="button" class="gallery-dialog-arrow gallery-dialog-prev" data-gallery-prev aria-label={t("Önceki fotoğraf")} disabled={images.length < 2}><Icon name="chevron" size={25} /></button>
        <div class="gallery-lightbox-photo"><img class="gallery-lightbox-image" src={images[0].src} alt={images[0].alt || t('Datça fotoğrafı')} decoding="async" /></div>
        <button type="button" class="gallery-dialog-arrow gallery-dialog-next" data-gallery-next aria-label={t("Sonraki fotoğraf")} disabled={images.length < 2}><Icon name="chevron" size={25} /></button>
      </div>
      <footer class="gallery-dialog-footer"><div><p id={`${galleryId}-caption`} class="gallery-dialog-caption">{images[0].alt || t('Datça fotoğrafı')}</p><a data-gallery-credit class="gallery-license" href={images[0].source} target="_blank" rel="noopener noreferrer">{images[0].photographer} · {images[0].license}</a><span id={`${galleryId}-status`} class="gallery-dialog-status" aria-live="polite" aria-atomic="true">1 / {images.length}</span></div><span class="gallery-keyboard-tip">{t("← → Fotoğrafları gez")} <span>·</span> {t("Esc Kapat")}</span></footer>
    </div>
  </dialog>
  <script type="application/json" data-gallery-images set:html={JSON.stringify(images).replace(/</g, '\\u003c')} />
</section>}

<script>
 import { clientUI } from '../lib/ui';
 import { mountInfiniteList } from '../scripts/infinite-list';
 const t=clientUI();
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(gallery => {
    const images: { src: string; alt: string; photographer:string;source:string;license:string }[] = JSON.parse(gallery.querySelector('[data-gallery-images]')?.textContent || '[]');
    const grid = gallery.querySelector<HTMLElement>('.gallery-photo-grid')!;
    const showItems = mountInfiniteList(gallery.querySelector<HTMLButtonElement>('[data-list-more]')!);
    showItems([...grid.querySelectorAll<HTMLButtonElement>('[data-gallery-index]')]);
    grid.dataset.ready = '';
    const dialog = gallery.querySelector<HTMLDialogElement>('.gallery-lightbox')!;
    const preview = dialog.querySelector<HTMLImageElement>('.gallery-lightbox-image')!;
    const caption = dialog.querySelector<HTMLElement>('.gallery-dialog-caption')!;
    const status = dialog.querySelector<HTMLElement>('.gallery-dialog-status')!;
    const credit=dialog.querySelector<HTMLAnchorElement>('[data-gallery-credit]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-gallery-close]')!;
    let current = 0;
    let opener: HTMLButtonElement | null = null;
    let previousOverflow = '';
    const show = (index: number) => {
      current = (index + images.length) % images.length;
      const image = images[current];
      preview.src = image.src;
      preview.alt = image.alt || `${t('Datça fotoğrafı')} ${current+1}`;
      caption.textContent = image.alt || t('Datça fotoğrafı');
      credit.textContent=`${image.photographer} · ${image.license}`;
      credit.href=image.source;
      status.textContent = `${current + 1} / ${images.length}`;
    };
    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-index]').forEach(button => button.addEventListener('click', () => {
      opener = button;
      show(Number(button.dataset.galleryIndex));
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
      close.focus();
    }));
    close.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', event => {
      if (images.length < 2) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
    });
    dialog.addEventListener('click', event => {
      if (event.target === dialog || event.target === dialog.querySelector('.gallery-lightbox-stage')) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      opener?.focus({ preventScroll: true });
    });
  });
</script>
<style>.gallery-license{display:block;font-size:10px;text-decoration:underline;margin:5px 0 6px;color:inherit;opacity:.8}</style>
