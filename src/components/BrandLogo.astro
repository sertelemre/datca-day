---
interface Props {
  href: string;
  label: string;
  footer?: boolean;
}
const { href, label, footer = false } = Astro.props;
---
<a class:list={['brand-logo', { 'brand-logo-footer': footer }]} href={href} aria-label={label}>
  <img src="/images/datca-day.svg" alt="" width="259" height="64" />
</a>

<style>
  .brand-logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    width: 188px;
  }
  .brand-logo img { width: 100%; height: auto; }
  .brand-logo-footer { width: 210px; }
  @media (max-width: 600px) {
    .brand-logo:not(.brand-logo-footer) { width: 156px; }
  }
  @media (max-width: 374px) {
    .brand-logo:not(.brand-logo-footer) { width: 120px; }
  }
</style>
