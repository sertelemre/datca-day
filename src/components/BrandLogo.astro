---
interface Props { href:string; label:string; footer?:boolean }
const { href,label,footer=false } = Astro.props;
---
<a class:list={['brand-logo',{'brand-logo-footer':footer}]} href={href} aria-label={label}><img src="/images/wave-sun.png" alt="" width="58" height="37"/><span>datca<b>.</b>day</span></a>
<style>
.brand-logo{display:inline-flex;align-items:center;gap:7px;line-height:1;flex:none;color:#183b34}
.brand-logo img{width:54px;height:auto}.brand-logo span{font:750 35px/1 var(--sans);letter-spacing:-2px}.brand-logo b{color:#eb754f}
.brand-logo-footer span{font-size:39px}
@media(max-width:600px){.brand-logo:not(.brand-logo-footer) img{width:42px}.brand-logo:not(.brand-logo-footer) span{font-size:30px}}
@media(max-width:374px){.brand-logo:not(.brand-logo-footer){gap:4px}.brand-logo:not(.brand-logo-footer) img{width:30px}.brand-logo:not(.brand-logo-footer) span{font-size:23px}}
</style>
