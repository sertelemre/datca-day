---
import { getContent } from '../lib/i18n';
import { getLocale, localePath } from '../lib/i18n';
import Icon from './Icon.astro';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const copy = {
 tr: { title: 'Datça rehberini konuna göre bul', intro: 'Gezi, ulaşım, konaklama ve günlük ihtiyaçlar için ilgili rehberlere geç.', link: 'Rehberleri incele' },
 en: { title: 'Find your Datça guide by topic', intro: 'Go straight to guides for sightseeing, transport, accommodation and everyday needs.', link: 'Explore guides' },
 ru: { title: 'Найдите путеводитель по теме', intro: 'Перейдите к материалам о прогулках, транспорте, жилье и повседневных нуждах.', link: 'Смотреть материалы' },
}[locale];
---
<section class:list={['topic-directory', { 'topic-directory-compact': compact }]} aria-labelledby="topic-directory-heading" data-topic-directory>
 <header><h2 id="topic-directory-heading">{copy.title}</h2><p>{copy.intro}</p></header>
 <div class="topic-grid">{[...getContent(locale).categories.map(category=>({ id:category.slug, hub:category.path, name:category.name, description:category.description })), {id:"events",hub:localePath("/etkinlikler",locale),name:({tr:"Etkinlikler",en:"Events",ru:"События"})[locale],description:""}].map(topic => <a href={localePath(topic.hub, locale)} data-guide-topic={topic.id}><h3>{topic.name}</h3>{!compact && <p>{topic.description}</p>}<span>{copy.link}<Icon name="arrow" size={16}/></span></a>)}</div>
</section>
<style>
.topic-directory{padding:32px 0}.topic-directory header{max-width:760px;margin-bottom:24px}.topic-directory h2{font-size:clamp(28px,3.4vw,42px);line-height:1.2;margin-bottom:12px}.topic-directory header p,.topic-grid p{font-size:14px;line-height:1.8;color:var(--muted)}.topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.topic-grid>a{display:flex;flex-direction:column;gap:12px;padding:20px;border:1px solid var(--line);border-radius:7px;background:var(--paper)}.topic-grid>a:hover{border-color:var(--green)}.topic-grid h3{font:600 17px/1.45 var(--sans);overflow-wrap:anywhere}.topic-grid span{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;color:var(--green);font-size:12px;min-height:24px}.topic-directory-compact .topic-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.topic-directory-compact .topic-grid>a{padding:16px}.topic-directory-compact h3{font-size:15px}@media(max-width:850px){.topic-grid,.topic-directory-compact .topic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.topic-grid{grid-template-columns:1fr}.topic-directory-compact .topic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.topic-directory{padding:25px 0}.topic-grid>a{padding:18px}}
</style>
