---
import Icon from './Icon.astro';
import EventMedia from './EventMedia.astro';
import {events, calendarEvents, archivedIds, eventSources, checks, lastAttempt, type DatcaEvent} from '../lib/events';
import {eventText, eventLabels, eventNotes} from '../lib/event-copy';
import {dateLabel, hasEnded} from '../lib/event-dates';
import {eventPath, type Locale} from '../lib/paths';

interface Props { locale?: Locale; event?: DatcaEvent; }
const {locale = 'tr', event} = Astro.props;
const t = (tr:string,en:string,ru:string) => eventText(locale,[tr,en,ru]);
const label = (key:string) => eventText(locale,eventLabels[key]);
const home = locale === 'tr' ? '/' : '/' + locale + '/';
const calendar = {tr:'/etkinlikler',en:'/en/events',ru:'/ru/sobytiya'}[locale];
const date = (day:string) => dateLabel(day,locale);
const sourcesHeading = t('Etkinlik kaynakları','Event sources','Источники афиши');
const verified = t('Kaynak kontrolü','Source checked','Проверено');
const calendarTitle = t('Datça etkinlik takvimi','Datça events calendar','Афиша Датчи');
const getSource = (id:string) => eventSources.find(source => source.id === id)!;
const checkMap = new Map(checks.map(check => [check.id,check]));
const categories = [...new Set(calendarEvents.map(item => item.category))];
const range = (item:DatcaEvent) => (item.start === item.end ? date(item.start) : date(item.start) + ' – ' + date(item.end));
const timeLabel = (item:DatcaEvent) => [item.schedule === 'friday' ? t('Her cuma','Every Friday','По пятницам') : '',[item.time,item.closeTime].filter(Boolean).join('–')].filter(Boolean).join(' · ');
const notes = event && eventNotes(event);
const additionalSource = event && /yüzme maratonu/i.test(event.title) ? getSource('yuzme') : event && /badem çiçeği/i.test(event.title) ? getSource('badem') : undefined;
const groups = ['privateVenue','public','organizer','tickets','local'];
const list = event ? [] : calendarEvents;
const ended = !!event && hasEnded(event);
const withdrawn = !!event && archivedIds.has(event.id);
const archived = ended || withdrawn;
const pastLabel = t('Bu etkinlik sona erdi.','This event has ended.','Это событие завершилось.');
const withdrawnLabel = t('Bu duyuru arşivde. Güncel program için kaynağı kontrol et.','This announcement is archived. Check the source for the current programme.','Объявление в архиве. Актуальное расписание уточняйте у источника.');
const archiveHeading = t('Etkinlik arşivi','Event archive','Архив событий');
const history = event ? [] : events.filter(item => hasEnded(item) || archivedIds.has(item.id)).sort((a,b) => b.start.localeCompare(a.start));

const structured = event && (!withdrawn || ended) && {
  '@context':'https://schema.org','@type':'Event',name:event.title,
  url:new URL(eventPath(event,locale),Astro.site || Astro.url).href, sameAs:event.url,
  location:{'@type':'Place',name:event.venue,address:{'@type':'PostalAddress',addressLocality:'Datça',addressRegion:'Muğla',addressCountry:'TR'}},
  image:event.poster, description:notes ? eventText(locale,notes) : undefined,
  ...(event.schedule === 'friday'
    ? {eventSchedule:{'@type':'Schedule',startDate:event.start,endDate:event.end,repeatFrequency:'P1W',byDay:'https://schema.org/Friday',startTime:event.time,endTime:event.closeTime,scheduleTimezone:'Europe/Istanbul'}}
    : {startDate:event.time ? event.start + 'T' + event.time + ':00+03:00' : event.start,endDate:event.closeTime ? event.end + 'T' + event.closeTime + ':00+03:00' : event.end !== event.start ? event.end : undefined})
};
---
{structured && <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')}/>}
<div class="events-page">
{event ? <section class="container events-intro">
  <nav class="breadcrumbs" aria-label={t('Sayfa yolu','Breadcrumbs','Навигация')}><a href={home}>datca.day</a><Icon name="chevron" size={13}/><a href={calendar}>{calendarTitle}</a></nav>
  <div class="events-heading">
    <div><span class="eyebrow">{label(event.category)}</span>
      <h1>{event.title}</h1>
      <p class="event-archive-notice" data-detail-status data-end={event.end} data-close={event.closeTime} data-ended-label={pastLabel} hidden={!archived}><strong>{archiveHeading}</strong><span>{ended ? pastLabel : withdrawnLabel}</span></p>
      <p><Icon name="calendar" size={18}/> <time datetime={event.start}>{range(event)}</time>{event.time && ' · ' + timeLabel(event)}</p>
      <p><Icon name="pin" size={18}/> {event.venue}</p>
      {notes && !withdrawn && <p data-current-notes hidden={ended}>{eventText(locale,notes)}</p>}
      <a class="button" href={event.url} target="_blank" rel="noopener noreferrer">{t('Etkinlik duyurusu','Event announcement','Объявление')} <Icon name="external" size={16}/></a>
    </div>
    <aside class="events-note">
      <EventMedia poster={event.poster} title={event.title} detail/>
      <h2>{t('Etkinlik bilgileri','Event information','О событии')}</h2>
      <p><a class="text-link" href={event.url} target="_blank" rel="noopener noreferrer">{getSource(event.sourceId)?.name || new URL(event.url).hostname} <Icon name="external" size={14}/></a></p>
      {event.ticket && !withdrawn && <p data-ticket-link hidden={ended}><a class="text-link" href={event.ticket} target="_blank" rel="noopener noreferrer">{t('Bilet bilgisi','Ticket information','Информация о билетах')} <Icon name="external" size={14}/></a></p>}
      {additionalSource && <p><a class="text-link" href={additionalSource.url} target="_blank" rel="noopener noreferrer">{additionalSource.name} <Icon name="external" size={14}/></a></p>}
      <p>{verified} · {date(event.checked)}</p>
      <small>{t('Saatler Türkiye saatine göredir.','Times are local to Türkiye.','Время указано местное.')}</small>
    </aside>
  </div>
</section> : null}
{event ? <div class="container events-back"><a class="text-link" href={calendar}>{calendarTitle} <Icon name="arrow" size={16}/></a></div> : <>
<section class="container events-calendar" data-datca-calendar>
  <header class="calendar-title"><h1>{calendarTitle}</h1><p aria-live="polite"><span data-count>{list.filter(item => !hasEnded(item)).length}</span> {t('etkinlik','events','· событий')}</p></header>
  <div class="event-filters calendar-filters" data-controls hidden>
    <label>{t('Tarih','Date','Дата')}<select data-period><option value="upcoming">{t('Yaklaşanlar','Upcoming','Предстоящие')}</option><option value="today">{t('Bugün','Today','Сегодня')}</option><option value="week">{t('Önümüzdeki 7 gün','Next 7 days','Ближайшие 7 дней')}</option><option value="past">{t('Son 7 gün','Past 7 days','Прошедшие 7 дней')}</option></select></label>
    <label>{t('Etkinlik türü','Event type','Тип события')}<select data-category-select><option value="">{t('Tüm türler','All types','Все типы')}</option>{categories.map(key => <option value={key}>{label(key)}</option>)}</select></label>
  </div>
  <div class="events-grid">{list.map(item => <article class="event-card" data-event data-start={item.start} data-end={item.end} data-close={item.closeTime} data-kind={item.category} data-schedule={item.schedule} hidden={hasEnded(item)}>
    <EventMedia poster={item.poster} title={item.title}/>
    <div class="event-card-body"><div class="event-card-top"><span>{label(item.category)}</span></div><h2 class="event-name"><a href={eventPath(item,locale)}>{item.title}</a></h2>
    <div class="event-date"><Icon name="calendar" size={18}/><div><time datetime={item.start}>{range(item)}</time>{item.time && <small>{timeLabel(item)}</small>}</div></div>
    <div class="event-location"><Icon name="pin" size={18}/><strong>{item.venue}</strong></div>
    <div class="event-source"><a href={item.url} target="_blank" rel="noopener noreferrer">{getSource(item.sourceId)?.name || new URL(item.url).hostname} <Icon name="external" size={14}/></a>
    <small>{verified} · {date(item.checked)}</small></div></div>
  </article>)}</div>
  <div class="events-empty" data-empty hidden={list.some(item => !hasEnded(item))}><h2>{t('Bu seçim için etkinlik bulunamadı.','No events match this selection.','По вашему запросу событий нет.')}</h2><a class="text-link" href="#etkinlik-kaynaklari">{sourcesHeading} <Icon name="down" size={16}/></a></div>
  {history.length > 0 && <details class="event-history"><summary>{archiveHeading} ({history.length})</summary><ul>{history.map(item => <li><time datetime={item.start}>{range(item)}</time><a href={eventPath(item,locale)}>{item.title}</a></li>)}</ul></details>}
</section>
<section class="events-sources-wrap" id="etkinlik-kaynaklari"><div class="container events-sources">
  <div class="events-section-heading"><div><span class="eyebrow">{t('DUYURULARIN İZİNDE','FOLLOW THE ANNOUNCEMENTS','СЛЕДИМ ЗА АНОНСАМИ')}</span><h2>{sourcesHeading}</h2></div><span>{eventSources.length} {t('kaynak sayfası','source pages','страницы источников')}</span></div>
  <p class="events-source-intro">{t('Otomatik taranan takvimler ve ayrıca inceleyebileceğin yerel duyuru sayfaları. Bilet ve seans bilgisi için ilgili mekânın programına git.','Browse automatically checked calendars and additional local announcement pages. Use the venue’s programme for ticket and session details.','Здесь собраны календари с автоматической проверкой и дополнительные местные источники. Билеты и расписание сеансов уточняйте у площадки.')}</p>
  <p class="source-checked">{t('Son tarama','Latest check','Последняя проверка')} · <time datetime={lastAttempt}>{date(lastAttempt)}</time>. {t('Saatler Türkiye saatine göredir.','Times are local to Türkiye.','Время указано местное.')}</p>
  <div class="event-source-grid">{groups.map(group => <details class="source-card" open={group === 'privateVenue'}><summary><h3>{label(group)}</h3><span class="source-expand"><Icon name="plus" size={20}/></span></summary>
    <ul>{eventSources.filter(source => source.kind === group).map(source => {
      const check = checkMap.get(source.id);
      return <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} <Icon name="external" size={13}/></a><small>{label(source.topic === 'local' ? 'localTopic' : source.topic)} · {source.adapter ? t('Otomatik takvim','Automatic calendar','Автопроверка') : t('Duyuru sayfası','Announcement page','Страница объявлений')}{check?.checked && ' · ' + date(check.checked)}{check?.status === 'error' && ' · ' + t('Son tarama başarısız','Last check failed','Последняя проверка не удалась')}</small></li>;
    })}</ul>
  </details>)}</div>
</div></section></>}
</div>
<script>
  import {todayInDatca,offsetDay,fallsWithin,hasEnded} from '../lib/event-dates';
  const detail = document.querySelector<HTMLElement>('[data-detail-status]');
  if (detail && hasEnded({end:detail.dataset.end!, closeTime:detail.dataset.close})) {
    detail.hidden = false;
    detail.querySelector('span')!.textContent = detail.dataset.endedLabel!;
    for (const node of document.querySelectorAll<HTMLElement>('[data-ticket-link],[data-current-notes]')) node.hidden = true;
  }
  const calendar = document.querySelector<HTMLElement>('[data-datca-calendar]');
  if (calendar) {
    const period = calendar.querySelector<HTMLSelectElement>('[data-period]')!;
    const category = calendar.querySelector<HTMLSelectElement>('[data-category-select]')!;
    const cards = [...calendar.querySelectorAll<HTMLElement>('[data-event]')];
    function apply() {
      const today = todayInDatca();
      const span:Record<string,[string,string]> = {upcoming:[today,'9999-12-31'],today:[today,today],week:[today,offsetDay(today,6)],past:[offsetDay(today,-7),today]};
      const [from,to] = span[period.value] || span.upcoming;
      let count = 0;
      for (const card of cards) {
        const {kind,start,end,schedule,close} = card.dataset;
        const past = hasEnded({end:end!,closeTime:close});
        card.hidden = (category.value !== '' && kind !== category.value) || (period.value === 'past' ? !past : past) || !fallsWithin(start!,end!,schedule,from,to);
        if (!card.hidden) count++;
      }
      calendar!.querySelector<HTMLElement>('[data-count]')!.textContent = String(count);
      calendar!.querySelector<HTMLElement>('[data-empty]')!.hidden = count > 0;
    }
    period.addEventListener('change',apply);
    category.addEventListener('change',apply);
    calendar.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
    apply();
  }
</script>

