round:none;padding:12px 0;min-height:46px;text-decoration:underline;text-underline-offset:4px;color:var(--muted);font-size:14px;cursor:pointer}.events-small-note{font-size:13px;color:var(--muted);margin:20px 0}.events-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:28px}.event-card{border:1px solid var(--line);border-radius:7px;padding:24px;display:flex;flex-direction:column;min-width:0;background:var(--paper)}.event-card[hidden]{display:none}.event-card-top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center;font-size:12px;color:var(--muted)}.event-card-top>span{letter-spacing:.6px;text-transform:uppercase}.event-status{background:var(--cream);color:var(--accent-text);padding:4px 8px;border-radius:3px;font-weight:500;font-size:12px}.event-card .event-name{font-family:var(--serif);font-size:29px;line-height:1.15;font-weight:700;margin:16px 0 21px;overflow-wrap:anywhere}.event-date,.event-location{display:flex;gap:10px;align-items:flex-start;font-size:14px;line-height:1.7;margin-bottom:14px}.event-date>svg,.event-location>svg{flex-shrink:0;margin-top:3px;color:var(--orange)}.event-date small{display:block;color:var(--muted);font-size:12px}.event-location strong{font-weight:500;display:block}.event-location span{font-size:13px;color:var(--muted);display:block}.event-description{font-size:15px;line-height:1.8;color:var(--muted);margin-bottom:15px}.event-price{font-size:13px;margin-bottom:15px}.event-source{border-top:1px solid var(--line);margin-top:auto;padding-top:15px}.event-source>a{font-size:13px;display:flex;align-items:center;gap:7px;flex-wrap:wrap;color:var(--accent-text)}.event-source small{font-size:12px;color:var(--muted);display:block;margin-top:8px;line-height:1.6}.event-cancelled h3{text-decoration:line-through;text-decoration-color:var(--line)}.events-empty{border:1px dashed var(--line);border-radius:7px;padding:45px 24px;text-align:center;margin-top:28px;background:var(--cream)}.events-empty[hidden]{display:none}.events-empty-icon{display:inline-flex;border:1px solid var(--line);border-radius:50%;width:65px;height:65px;align-items:center;justify-content:center;color:var(--orange)}.events-empty h2{font-size:35px;margin:19px 0 13px}.events-empty p{font-size:16px;line-height:1.85;color:var(--muted);max-width:680px;margin:0 auto 20px}.events-empty .text-link{justify-content:center}.events-sources-wrap{background:var(--cream);border-top:1px solid var(--line)}.events-sources{padding-top:55px;padding-bottom:64px;scroll-margin-top:100px}.events-source-intro{max-width:830px;font-size:16px;line-height:1.9;color:var(--muted);margin:18px 0 23px}.events-coverage{border:1px solid var(--line);border-radius:5px;display:flex;align-items:flex-start;gap:14px;padding:19px 22px;background:var(--paper);margin-bottom:27px}.events-coverage>svg{flex-shrink:0;margin-top:3px;color:var(--orange)}.events-coverage strong{display:block;font-size:14px;margin-bottom:5px;font-weight:500}.events-coverage span{font-size:14px;line-height:1.8;color:var(--muted)}.event-source-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;align-items:start}.source-card{background:var(--paper);border:1px solid var(--line);border-radius:5px;min-width:0}.source-card summary{display:flex;justify-content:space-between;gap:20px;padding:22px;list-style:none;cursor:pointer;align-items:center}.source-card summary::-webkit-details-marker{display:none}.source-kind{font-size:12px;color:var(--muted);line-height:1.7;display:block}.source-card h3{font-family:var(--serif);font-size:25px;line-height:1.25;font-weight:500;margin:7px 0}.source-status{font-size:12px;color:var(--muted)}.source-expand{display:flex;flex-shrink:0;transition:transform .15s}.source-card[open] .source-expand{transform:rotate(45deg)}.source-details{border-top:1px solid var(--line);padding:20px 22px}.source-details>p{font-size:14px;line-height:1.8;color:var(--muted)}.source-details dl{margin:18px 0}.source-details dl>div{display:grid;grid-template-columns:1fr 1.15fr;gap:15px;margin-bottom:10px;font-size:13px;line-height:1.6}.source-details dt{color:var(--muted)}.source-details dd{margin:0;overflow-wrap:anywhere}.source-check-message{background:var(--cream);padding:10px 12px;margin-bottom:15px}.source-details .source-stale{color:var(--accent-text);font-size:13px;margin:12px 0}.source-stale[hidden]{display:none}.source-links{display:flex;gap:20px;flex-wrap:wrap;margin-top:16px}.source-links a{display:flex;align-items:center;gap:7px;font-size:14px;color:var(--accent-text);text-decoration:underline;text-underline-offset:4px}.events-submit{border-top:1px solid var(--line);margin-top:38px;padding-top:29px;display:flex;justify-content:space-between;align-items:center;gap:25px}.events-submit h3{font-family:var(--serif);font-size:29px;font-weight:500;margin-bottom:8px}.events-submit p{font-size:14px;line-height:1.8;color:var(--muted);max-width:680px}.events-submit .button{flex-shrink:0}.events-page a:focus-visible,.events-page summary:focus-visible,.events-page button:focus-visible,.events-page select:focus-visible{outline:2px solid var(--green);outline-offset:4px}
  @media(max-width:1050px){.events-heading{gap:35px;grid-template-columns:1fr 310px}.events-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.events-heading h1{font-size:56px}.events-note{padding:23px}.events-heading>div>p{font-size:16px}}
  .event-stale{font-size:13px;line-height:1.7;color:var(--accent-text);background:var(--cream);padding:10px 12px;margin-top:13px}.event-stale[hidden]{display:none}
  @media(max-width:750px){.events-heading{grid-template-columns:1fr;gap:28px}.events-heading h1{font-size:54px}.events-note{max-width:none}.events-note dl{display:grid;grid-template-columns:1fr 1fr;gap:16px}.events-note dl>div+div{margin:0}.event-source-grid{grid-template-columns:1fr}.events-calendar{padding-bottom:45px}.events-submit{align-items:flex-start;flex-direction:column}.events-section-heading h2{font-size:37px}.events-sources{padding-top:42px;padding-bottom:45px}.event-filters>div{min-width:0;flex:1}.event-filter-reset{width:100%;text-align:left;padding-top:0;min-height:35px}.events-warning{margin-top:24px}}
  @media(max-width:560px){.events-intro{padding-top:32px;padding-bottom:25px}.events-heading h1{font-size:46px;letter-spacing:-1px}.events-grid{grid-template-columns:1fr;gap:17px}.event-filters{gap:16px}.event-filters>div{flex-basis:100%}.events-calendar{padding-top:15px}.events-section-heading{gap:13px}.events-section-heading h2{font-size:33px}.events-section-heading>p{margin-bottom:0}.events-empty{padding:32px 21px}.events-empty h2{font-size:29px}.events-note dl{grid-template-columns:1fr}.source-card summary{padding:19px}.source-card h3{font-size:24px}.source-details{padding:19px}.source-details dl>div{grid-template-columns:1fr;gap:2px;margin-bottom:14px}.events-coverage{padding:17px;gap:11px}}
  .events-page h1,.events-page h2,.events-page h3,.events-heading h1 em{font-weight:700}
  .event-filters>.event-category-filter{flex-basis:100%;min-width:0;order:2;gap:10px}
  .event-category-options{display:flex;flex-wrap:wrap;gap:8px}
  .event-category-options button{border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--green);padding:9px 15px;min-height:44px;font-size:14px;line-height:1.4;cursor:pointer}
  .event-category-options button:hover{border-color:var(--green);background:var(--cream)}
  .event-category-options button[aria-pressed=true]{border-color:var(--green);background:var(--green);color:var(--paper);font-weight:700}
  .event-card,.cinema-card{padding:0;overflow:hidden}
  .event-past{border-style:dashed;background:var(--cream)}
  .event-past :global([data-event-media]){filter:grayscale(.8);opacity:.7}
  .event-ended{background:var(--line);color:var(--green)}
  .event-ended[hidden]{display:none}
  .event-card-body{display:flex;flex-direction:column;flex:1;min-width:0;padding:24px}
  @media(max-width:560px){.event-card-body{padding:21px}}
