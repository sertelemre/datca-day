---
import { ui } from '../lib/ui';
import { getLocale, localePath } from '../lib/i18n';
import Icon from './Icon.astro';

const locale = getLocale(Astro.url.pathname);
const t = ui(locale);
---
<section class="contact-form-section" aria-labelledby="contact-form-heading">
  <div class="contact-form-intro">
    <p class="detail-eyebrow">{t('SÖZ SENDE')}</p>
    <h2 id="contact-form-heading">{t('Bize yaz.')}</h2>
    <p>{t('Bir önerin, sorun ya da paylaşmak istediğin bir not mu var? Mesajını buradan iletebilirsin.')}</p>
  </div>
  {import.meta.env.PUBLIC_CONTACT_FORM_URL ? <form
    class="contact-form"
    data-contact-form
    action={import.meta.env.PUBLIC_CONTACT_FORM_URL}
    method="POST"
    data-sending={t('Gönderiliyor…')}
    data-success={t('Mesajın gönderildi. Bizimle paylaştığın için teşekkürler.')}
    data-error={t('Mesajın gönderilemedi. Lütfen biraz sonra tekrar dene.')}
  >
    <fieldset>
      <legend class="sr-only">{t('İletişim formu')}</legend>
      <div class="contact-form-fields">
        <div class="contact-form-field">
          <label for="contact-name">{t('Adın')}</label>
          <input id="contact-name" name="name" autocomplete="name" required />
        </div>
        <div class="contact-form-field">
          <label for="contact-email">{t('E-posta adresin')}</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="contact-form-field contact-form-message">
          <label for="contact-message">{t('Mesajın')}</label>
          <textarea id="contact-message" name="message" rows="6" aria-describedby="contact-message-hint" required></textarea>
          <p id="contact-message-hint" class="contact-form-hint">{t('Bir düzeltme öneriyorsan ilgili sayfanın bağlantısını ve kaynağını da ekleyebilirsin.')}</p>
        </div>
      </div>
      <input class="contact-form-honeypot" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="button contact-form-submit" type="submit"><span data-submit-label>{t('Mesajı gönder')}</span><Icon name="arrow" size={18} /></button>
    </fieldset>
    <p class="contact-form-privacy">{t('Formu gönderdiğinde adın, e-posta adresin ve mesajın Polybase üzerinden iletilir.')} <a href={localePath('/gizlilik', locale)}>{t('Gizlilik')}</a></p>
    <p class="contact-form-status" data-form-status role="status" aria-live="polite" aria-atomic="true"></p>
  </form> : <div><a class="button" href="https://github.com/sertelemre/datca-day/issues/new" rel="external">{t("GitHub üzerinden öneri paylaş")} <Icon name="external" size={17}/></a></div>}
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const fields = form.querySelector('fieldset')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submitLabel = label.textContent;
    let submitting = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;

      const data = new FormData(form);
      submitting = true;
      fields.disabled = true;
      form.setAttribute('aria-busy', 'true');
      label.textContent = form.dataset.sending!;
      status.textContent = '';
      delete status.dataset.state;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            email: data.get('email'),
            message: data.get('message'),
            _gotcha: data.get('_gotcha'),
          }),
          signal: AbortSignal.timeout(20000),
        });
        if (!response.ok) throw new Error('Form submission failed');
        form.reset();
        status.dataset.state = 'success';
        status.textContent = form.dataset.success!;
      } catch {
        status.dataset.state = 'error';
        status.textContent = form.dataset.error!;
      } finally {
        submitting = false;
        fields.disabled = false;
        form.removeAttribute('aria-busy');
        label.textContent = submitLabel;
      }
    });
  }
</script>

<style>
  .contact-form-section{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.7fr);gap:72px;border-top:1px solid var(--line);padding:48px 0 32px}
  .contact-form-intro h2{font-size:48px;margin:15px 0 20px}
  .contact-form-intro>p:last-child{max-width:310px;color:var(--muted);font-size:16px;line-height:1.9}
  .contact-form{min-width:0}
  .contact-form fieldset{min-width:0;margin:0;padding:0;border:0}
  .contact-form-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
  .contact-form-field{display:flex;flex-direction:column;gap:9px}
  .contact-form-field label{font-size:14px;font-weight:500;color:var(--green)}
  .contact-form-field input,.contact-form-field textarea{width:100%;min-width:0;border:1px solid #bac4b3;border-radius:5px;background:var(--paper);color:var(--ink);padding:12px 14px;line-height:1.6}
  .contact-form-field input:focus,.contact-form-field textarea:focus{border-color:var(--green)}
  .contact-form-field textarea{resize:vertical;min-height:170px}
  .contact-form-message{grid-column:1/-1}
  .contact-form-hint,.contact-form-privacy{font-size:13px;line-height:1.7;color:var(--muted)}
  .contact-form-honeypot{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .contact-form-submit{margin-top:25px}
  .contact-form-submit:disabled{opacity:.65;transform:none}
  .contact-form-privacy{margin-top:16px}
  .contact-form-privacy a{text-decoration:underline;text-underline-offset:3px;color:var(--green)}
  .contact-form-status{min-height:24px;margin-top:13px;font-size:14px;line-height:1.7;overflow-wrap:anywhere}
  .contact-form-status[data-state=success]{color:var(--green)}
  .contact-form-status[data-state=error]{color:var(--accent-text)}
  @media(max-width:800px){.contact-form-section{grid-template-columns:minmax(0,1fr);gap:28px;padding-top:35px}.contact-form-intro h2{font-size:40px}.contact-form-intro>p:last-child{max-width:520px}}
  @media(max-width:560px){.contact-form-fields{grid-template-columns:minmax(0,1fr);gap:20px}.contact-form-submit{width:100%;justify-content:space-between}}
</style>
