---
import { ui } from '../lib/ui';
import { getLocale, localePath } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = ui(locale);
const localize = (path: string) => localePath(path, locale);

import type { Article, Category } from '../lib/types';
import { inCategory, categoryImage } from '../lib/content';
import LocalServices from './LocalServices.astro';
import Card from './Card.astro';
import Icon from './Icon.astro';
import LoadMore from './LoadMore.astro';
import { listBatchSize } from '../scripts/infinite-list';
import './secondary.css';

interface Props { category: Category; articles: Article[]; subcategories: Category[]; }
const { category, articles, subcategories = [] } = Astro.props;
const cover = categoryImage(category);
const description = category.description;
---

<div class="category-page">
  <section class:list={['category-banner', { 'category-banner-with-image': cover }] }>
    {cover && <div class="category-banner-image" aria-hidden="true"><img src={cover} alt="" fetchpriority="high" /></div>}
    <div class="detail-container category-banner-inner">
      <nav class="detail-breadcrumb" aria-label={t("Sayfa yolu")}><a href={localize("/")}>datca.day</a><Icon name="chevron" size={12} /><span>{category.name}</span></nav>
      <span class="category-kicker"><span></span> {t("DATÇA’YI YAŞA")}</span>
      <h1>{category.name}</h1>
      <p>{description}</p>
      <div class="category-total"><Icon name="compass" size={17} /><span>{t("{n} keşif seni bekliyor", {n:articles.length})}</span></div>
    </div>
  </section>

  <slot name="guide-navigation"/>
  <div class="detail-container"><LocalServices slug={category.slug}/></div>

  <section class="category-results detail-container" data-category-listing>
    {category.intro && <div class="category-editorial" set:html={category.intro}/>}
    <div class="category-toolbar">
      <div class="category-search"><Icon name="search" size={19} /><label class="sr-only" for="category-search">{t("Rehberlerde ara")}</label><input id="category-search" type="search" placeholder={t("Bir yer, bir deneyim, bir lezzet ara…")} autocomplete="off" /><button type="button" id="category-search-clear" aria-label={t("Aramayı temizle")} hidden><Icon name="close" size={16} /></button></div>
      <div class="category-display-tools"><label class="sr-only" for="category-sort">{t("Sıralama")}</label><select id="category-sort"><option value="default">{t("Önerilen sıralama")}</option><option value="newest">{t("En yeni")}</option><option value="az">{t("İsme göre A–Z")}</option><option value="za">{t("İsme göre Z–A")}</option></select><div class="category-view-toggle" aria-label={t("Görünüm")}><button type="button" data-view="grid" class="is-active" aria-pressed="true" aria-label={t("Izgara görünümü")}><Icon name="grid" size={18} /></button><button type="button" data-view="list" aria-pressed="false" aria-label={t("Liste görünümü")}><Icon name="list" size={18} /></button></div></div>
    </div>
    {subcategories.length > 0 && <div class="category-filters" aria-label={t("Alt kategori filtresi")}><button type="button" data-category="all" class="is-active" aria-pressed="true">{t("Tümünü keşfet")} <span>{articles.length}</span></button>{subcategories.map(subcategory => <button type="button" data-category={subcategory.id} aria-pressed="false">{subcategory.name}<span>{articles.filter(article => inCategory(article, subcategory)).length}</span></button>)}</div>}
    <div class="category-results-heading"><p id="category-results-count" role="status" aria-live="polite"><strong>{articles.length}</strong> {t("rehber", {n:articles.length})}</p><span>{t("Datça’dan ilham veren hikâyeler")}</span></div>
    <div class="category-article-grid" id="category-article-grid" data-infinite-grid>{articles.map((article, index) => <div class="category-article-item" data-deferred={index >= listBatchSize || undefined} data-title={article.title} data-excerpt={article.excerpt} data-terms={article.searchTerms} data-categories={[...new Set([...article.categories, ...subcategories.filter(subcategory => inCategory(article, subcategory)).map(subcategory => subcategory.id)])].join(',')} data-date={article.date} data-order={index}><Card article={article} /></div>)}</div>
    <div class="category-empty" id="category-empty" hidden><div><Icon name="search" size={30} /></div><h2>{t("Henüz bir eşleşme yok.")}</h2><p>{t("Başka bir sözcük dene veya tüm rehberleri keşfet.")}</p><button type="button" id="category-reset">{t("Filtreleri temizle")} <Icon name="arrow" size={17} /></button></div>
    <LoadMore controls="category-article-grid"/>
  </section>
  <section class="category-bottom-note detail-container"><div><Icon name="sun" size={27} /></div><p><strong>{t("Her mevsim başka bir Datça.")}</strong><span>{t("Bir sonraki keşfini bugünden planla.")}</span></p><a href={localize("/tatil-planim")}>{t("Rotanı oluştur")} <Icon name="arrow" size={17} /></a></section>
</div>

<script>
  import { clientUI } from '../lib/ui';
  import { listBatchSize, mountInfiniteList } from '../scripts/infinite-list';
  const t = clientUI();
  const listing = document.querySelector<HTMLElement>('[data-category-listing]');
  if (listing) {
    const input = listing.querySelector<HTMLInputElement>('#category-search')!;
    const sort = listing.querySelector<HTMLSelectElement>('#category-sort')!;
    const grid = listing.querySelector<HTMLElement>('#category-article-grid')!;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.category-article-item'));
    const count = listing.querySelector<HTMLElement>('#category-results-count')!;
    const empty = listing.querySelector<HTMLElement>('#category-empty')!;
    const more = listing.querySelector<HTMLButtonElement>('[aria-controls="category-article-grid"]')!;
    const clear = listing.querySelector<HTMLButtonElement>('#category-search-clear')!;
    const query = new URLSearchParams(window.location.search).get('q');
    if (query) input.value = query;
    let selectedCategory = 'all';
    const initialPage = Math.max(1, Number.parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10) || 1);
    const showItems = mountInfiniteList(more, (shown, total) => {
      const strong = document.createElement('strong');
      strong.textContent = shown + ' / ' + total;
      count.replaceChildren(strong, ' ' + t('rehber', {n:total}));
    });
    const normalize = (value: string) => value.toLocaleLowerCase(document.documentElement.lang).normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ı/g, 'i');
    const render = (initialCount = listBatchSize) => {
      const search = normalize(input.value.trim());
      clear.hidden = !search;
      let matching = cards.filter(card => (!search || normalize(`${card.dataset.title} ${card.dataset.excerpt} ${card.dataset.terms || ''}`).includes(search)) && (selectedCategory === 'all' || (card.dataset.categories || '').split(',').includes(selectedCategory)));
      if (sort.value === 'az' || sort.value === 'za') matching.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || '', document.documentElement.lang) * (sort.value === 'za' ? -1 : 1));
      else if (sort.value === 'newest') matching.sort((a, b) => (Date.parse(b.dataset.date || '') || 0) - (Date.parse(a.dataset.date || '') || 0));
      else matching.sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
      cards.forEach(card => card.hidden = true);
      matching.forEach(card => grid.appendChild(card));
      showItems(matching, initialCount);
      empty.hidden = matching.length !== 0;
      grid.dataset.ready = '';
    };
    input.addEventListener('input', () => render());
    clear.addEventListener('click', () => { input.value = ''; render(); input.focus(); });
    sort.addEventListener('change', () => render());
    listing.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(button => button.addEventListener('click', () => {
      selectedCategory = button.dataset.category || 'all';
      listing.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(item => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); }); render();
    }));
    listing.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => button.addEventListener('click', () => {
      grid.classList.toggle('is-list-view', button.dataset.view === 'list');
      listing.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(item => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', String(item === button)); });
    }));
    listing.querySelector('#category-reset')?.addEventListener('click', () => { input.value = ''; selectedCategory = 'all'; sort.value = 'default'; listing.querySelector<HTMLButtonElement>('[data-category="all"]')?.click(); render(); });
    render(initialPage * listBatchSize);
  }
</script>
<style>.category-editorial{max-width:850px;margin:0 0 28px;padding-bottom:24px;border-bottom:1px solid var(--line);font-size:13px;line-height:1.9;color:var(--muted)}.category-editorial :global(p+p){margin-top:14px}.category-editorial :global(a){color:var(--orange);text-decoration:underline}.category-editorial :global(h2){font-size:32px;color:var(--green);margin-bottom:15px}</style>
