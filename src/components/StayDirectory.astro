---
import data from '../lib/stays.json';
import type { Locale } from '../lib/paths';
import Icon from './Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const labels = {
  tr:{title:'Datça otelleri ve konaklama yerleri',search:'Tesis adı veya bölge',area:'Tüm mahalleler',type:'Tüm tesis türleri',photos:'Yalnızca fotoğraflılar',gallery:'Fotoğraf galerisi',map:'Haritada ara',web:'Tesisin sitesi',prev:'Önceki',next:'Sonraki',reset:'Filtreleri temizle',source:'Bakanlık tesis sorgusu',contact:'Muğla İl Kültür ve Turizm Müdürlüğü',asOf:'Kayıt kontrolü',number:'Belge',application:'Başvuru',count:'tesis',hotel:'Otel',apart:'Apart otel',guest:'Pansiyon',boutique:'Butik otel',special:'Özel konaklama tesisi',country:'Kırsal konaklama',camp:'Kamping',motel:'Motel',rental:'Turizm amaçlı konut',pending:'Başvurusu olan tesis',scope:'Bakanlık listesinde {certified} belgeli tesis var. Rehberde ayrıca ilanında konut izin numarası bulunan {rental} konut ve başvurusu görünen {pending} tesis yer alıyor.'},
  en:{title:'Hotels and places to stay in Datça',search:'Property name or area',area:'All neighbourhoods',type:'All property types',photos:'With photos only',gallery:'Photo gallery',map:'Find on map',web:'Property website',prev:'Previous',next:'Next',reset:'Clear filters',source:'Ministry register',contact:'Muğla Provincial Directorate of Culture and Tourism',asOf:'Records checked',number:'Certificate',application:'Application',count:'properties',hotel:'Hotel',apart:'Aparthotel',guest:'Guesthouse',boutique:'Boutique hotel',special:'Special accommodation',country:'Rural accommodation',camp:'Campsite',motel:'Motel',rental:'Licensed holiday home',pending:'Application on file',scope:'The Ministry lists {certified} certified properties. The directory also includes {rental} holiday homes with published permit numbers and {pending} properties with applications on file.'},
  ru:{title:'Отели и жильё в Датче',search:'Название или район',area:'Все районы',type:'Все типы жилья',photos:'Только с фото',gallery:'Фотогалерея',map:'Найти на карте',web:'Сайт объекта',prev:'Назад',next:'Далее',reset:'Сбросить фильтры',source:'Реестр министерства',contact:'Управление культуры и туризма Муглы',asOf:'Дата проверки',number:'Свидетельство',application:'Заявка',count:'объектов',hotel:'Отель',apart:'Апарт-отель',guest:'Пансион',boutique:'Бутик-отель',special:'Особый тип размещения',country:'Загородное жильё',camp:'Кемпинг',motel:'Мотель',rental:'Лицензированное жильё',pending:'Подана заявка',scope:'В реестре министерства {certified} сертифицированных объектов. Также представлены {rental} лицензированных домов для отдыха и {pending} объекта, подавших заявку.'},
}[locale];
const types = {otel:'hotel','apart otel':'apart',pansiyon:'guest','butik otel':'boutique','ozel konaklama tesisi':'special',motel:'motel',camping:'camp','kamping, pansiyon':'camp','kirsal turizm tesisi':'country','ciftlik evi-koy evi':'country',rental:'rental',application:'pending'} as const;
const kind = (type: string) => types[type as keyof typeof types];
const spots = data.slice().sort((a,b) => Number(!!b.photo)-Number(!!a.photo) || Number(kind(b.type)==='hotel')-Number(kind(a.type)==='hotel') || (a.alias || a.name).localeCompare(b.alias || b.name,'tr'));
const rentals = spots.filter(spot => spot.type === 'rental').length;
const pending = spots.filter(spot => spot.type === 'application').length;
const scope = labels.scope.replace('{certified}', String(spots.length-rentals-pending)).replace('{rental}', String(rentals)).replace('{pending}', String(pending));
const areas = [...new Set(data.map(spot => spot.area).filter((s): s is string => !!s))].sort((a,b)=>a.localeCompare(b,'tr'));
const photoSource = (url:string) => new URL(url).hostname.replace(/^www\./,'');
---
<section class="stays" id="konaklama-rehberi" data-stay-directory aria-labelledby="stays-title">
  <h2 id="stays-title">{labels.title}</h2>
  <p class="scope">{scope}</p>
  <div class="filters" data-stay-controls hidden>
    <label class="search"><Icon name="search" size={18}/><input type="search" data-stay-search placeholder={labels.search} aria-label={labels.search}/></label>
    <select data-stay-area aria-label={labels.area}><option value="">{labels.area}</option>{areas.map(area=><option value={area}>{area}</option>)}</select>
    <select data-stay-type aria-label={labels.type}><option value="">{labels.type}</option>{[...new Set(Object.values(types))].map(type=><option value={type}>{labels[type]}</option>)}</select>
    <label class="with-photos"><input type="checkbox" data-stay-photos/>{labels.photos}</label>
  </div>
  <div class="list-status"><p aria-live="polite" aria-atomic="true"><strong data-stay-total>{spots.length}</strong> {labels.count}</p><button data-stay-clear hidden>{labels.reset}</button></div>
  <div class="stay-grid">
    {spots.map(spot=>{
      const title = spot.alias || spot.name;
      const query = [title,spot.address,'Datça, Muğla'].filter(Boolean).join(', ');
      return <article class="stay" data-stay data-number={spot.number} data-area={spot.area} data-kind={kind(spot.type)} data-terms={[spot.name,spot.alias,spot.address,spot.area,spot.number].filter(Boolean).join(' ')}>
        {spot.photo && spot.gallery && <a class="stay-picture" href={spot.gallery} target="_blank" rel="noopener noreferrer" aria-label={title+' · '+labels.gallery}><img src={spot.photo} loading="lazy" decoding="async" referrerpolicy="no-referrer" width="450" height="235" alt={title}/></a>}
        <div class="stay-body">
          <p class="kind">{labels[kind(spot.type)]}{spot.area && <> · {spot.area}</>}</p>
          <h3>{title}</h3>
          {spot.address && <address>{spot.address}</address>}
          {spot.phone && <a class="phone" href={'tel:'+spot.phone.replaceAll(' ','')}><Icon name="phone" size={15}/>{spot.phone}</a>}
          <div class="stay-links"><a href={'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(query)} target="_blank" rel="noopener noreferrer"><Icon name="pin" size={15}/>{labels.map}</a>{spot.website && <a href={spot.website} target="_blank" rel="noopener noreferrer">{labels.web} ↗</a>}</div>
          <small>{spot.type==='application'?labels.application:labels.number} {spot.number}</small>
          {spot.gallery && <a class="credit" href={spot.gallery} target="_blank" rel="noopener noreferrer">{labels.gallery} · {photoSource(spot.gallery)} ↗</a>}
        </div>
      </article>
    })}
  </div>
  <nav data-stay-pages class="stay-pages" aria-label={labels.title} hidden><button data-stay-prev>{labels.prev}</button><span data-stay-page></span><button data-stay-next>{labels.next}</button></nav>
  <footer>{labels.asOf} · <time datetime="2026-11-10">{new Intl.DateTimeFormat(locale,{dateStyle:'long',timeZone:'Europe/Istanbul'}).format(new Date('2026-11-10T12:00:00Z'))}</time><a href="https://www.ktb.gov.tr/genel/searchhotelgenel.aspx?lang=tr" target="_blank" rel="noopener noreferrer">{labels.source} ↗</a><a href="https://mugla.ktb.gov.tr/TR-397257/konaklama-isletmeleri.html" target="_blank" rel="noopener noreferrer">{labels.contact} ↗</a></footer>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-stay-directory]');
  if (root) {
    const search = root.querySelector<HTMLInputElement>('[data-stay-search]')!;
    const area = root.querySelector<HTMLSelectElement>('[data-stay-area]')!;
    const type = root.querySelector<HTMLSelectElement>('[data-stay-type]')!;
    const photos = root.querySelector<HTMLInputElement>('[data-stay-photos]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-stay-clear]')!;
    const pages = root.querySelector<HTMLElement>('[data-stay-pages]')!;
    const prev = pages.querySelector<HTMLButtonElement>('[data-stay-prev]')!;
    const next = pages.querySelector<HTMLButtonElement>('[data-stay-next]')!;
    const fold = (s:string) => s.toLocaleLowerCase('tr').replaceAll('ı','i').normalize('NFD').replace(/\p{M}/gu,'');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-stay]')].map(el=>({el,words:fold(el.dataset.terms || ''),photo:!!el.querySelector('img')}));
    let page = 0;
    const size = 12;
    function render() {
      const query = fold(search.value.trim()).split(/\s+/).filter(Boolean);
      const matches = cards.filter(({el,words,photo})=>
        query.every(term=>words.includes(term)) && (!area.value || el.dataset.area===area.value) && (!type.value || el.dataset.kind===type.value) && (!photos.checked || photo));
      const count = Math.ceil(matches.length/size);
      const visible = new Set(matches.slice(page*size,(page+1)*size));
      for (const card of cards) card.el.hidden = !visible.has(card);
      root!.querySelector('[data-stay-total]')!.textContent=String(matches.length);
      pages.hidden=count<=1;
      pages.querySelector('[data-stay-page]')!.textContent=(page+1)+' / '+count;
      prev.disabled=page===0;
      next.disabled=page+1>=count;
      clear.hidden=!query.length && !area.value && !type.value && !photos.checked;
    }
    function filter() { page=0; render(); }
    function turn(step:number) {
      page+=step; render();
      const card=root!.querySelector<HTMLElement>('[data-stay]:not([hidden]) h3');
      if (card) {card.tabIndex=-1;card.focus({preventScroll:true});card.scrollIntoView({block:'start'});}
    }
    search.addEventListener('input',filter);
    for(const input of [area,type,photos]) input.addEventListener('change',filter);
    clear.addEventListener('click',()=>{search.value=area.value=type.value='';photos.checked=false;filter();search.focus();});
    prev.addEventListener('click',()=>turn(-1));
    next.addEventListener('click',()=>turn(1));
    root.addEventListener('error',event=>{
      if (event.target instanceof HTMLImageElement) event.target.closest<HTMLElement>('.stay-picture')!.hidden=true;
    },true);
    root.querySelector<HTMLElement>('[data-stay-controls]')!.hidden=false;
    render();
  }
</script>
<style>
  .stays { margin:22px 0 52px; text-align:left; color:var(--green); }
  .stays h2 { margin:0 0 8px; font-size:clamp(30px,4vw,46px); line-height:1.12; }
  .scope,.stay address { color:var(--muted); font-size:14px; line-height:1.55; }
  .filters { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:20px 0 8px; }
  .filters select,.search,.stay-pages button,.list-status button { border:1px solid var(--line); border-radius:6px; background:var(--paper); color:var(--green); padding:8px 12px; min-height:44px; font:inherit; font-size:14px; }
  .search { display:flex; gap:8px; align-items:center; flex:1 1 220px; }
  .search input { min-width:0; width:100%; font:inherit; background:transparent; border:0; }
  .with-photos,.phone,.stay-links a { display:inline-flex; align-items:center; gap:6px; }
  .with-photos { font-size:14px; min-height:44px; }
  .list-status,.stay-pages,.stays footer,.stay-links { display:flex; align-items:center; gap:10px 16px; flex-wrap:wrap; }
  .list-status { justify-content:space-between; min-height:48px; }
  .stay-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; align-items:start; }
  .stay { overflow:hidden; border:1px solid var(--line); border-radius:9px; background:var(--paper); }
  .stay-picture,.stay-picture img { display:block; width:100%; }
  .stay-picture img { aspect-ratio:1.91; object-fit:cover; height:auto; background:var(--cream); }
  .stay-body { padding:16px; display:grid; gap:7px; }
  .stay h3 { font:500 clamp(22px,2vw,27px)/1.12 var(--serif); margin:0; overflow-wrap:anywhere; }
  .stay address { font-style:normal; }
  .kind,.stay small,.credit { font-size:12px; line-height:1.5; }
  .kind { font-weight:650; }
  .phone,.stay-links,.credit,.stays footer a { font-size:13px; }
  .stay-links a,.phone,.credit,.stays footer a { text-decoration:underline; text-underline-offset:3px; width:fit-content; }
  .phone { font-weight:650; }
  .stay small,.stays footer { color:var(--muted); }
  .stay-pages { justify-content:center; margin:20px 0; }
  .stay-pages button:disabled { opacity:.45; }
  .stays footer { margin-top:20px; border-top:1px solid var(--line); padding-top:12px; font-size:13px; }
  @media(max-width:900px) { .stay-grid {grid-template-columns:repeat(2,minmax(0,1fr));} }
  @media(max-width:600px) { .stay-grid {grid-template-columns:1fr;} .filters {gap:5px;} .search {flex-basis:100%;} .filters select {max-width:100%;} .phone,.stay-links a,.credit {min-height:36px;display:inline-flex;align-items:center;} }
</style>
