---
import { ui } from '../lib/ui';
import { getLocale } from '../lib/i18n';

interface Props { controls: string }
const t = ui(getLocale(Astro.url.pathname));
---
<button type="button" class="listing-more" data-list-more aria-controls={Astro.props.controls} hidden>{t('Daha fazla göster')}</button>

<style>
  .listing-more { display:block; margin:24px auto; min-height:44px; padding:9px 18px; border:1px solid var(--line); border-radius:6px; background:var(--paper); color:var(--green); font:inherit; font-size:14px; cursor:pointer; }
  @media (scripting:enabled) { :global([data-infinite-grid]:not([data-ready]) > [data-deferred]) { display:none; } }
</style>
