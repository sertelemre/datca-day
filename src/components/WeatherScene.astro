---
const drops = Array.from({ length: 12 }, (_, index) => index);
const flakes = Array.from({ length: 12 }, (_, index) => index);
const stars = Array.from({ length: 9 }, (_, index) => index);
---

<div class="weather-scene" aria-hidden="true">
  <div class="weather-sky-glow"></div>
  <div class="weather-stars">
    {stars.map((star) => <i style={`--i:${star};--x:${[49, 72, 87, 57, 93, 39, 77, 63, 32][star]}%;--y:${[15, 9, 31, 38, 14, 26, 42, 21, 9][star]}%`}></i>)}
  </div>

  <div class="weather-orbit">
    <div class="weather-sun">
      <div class="weather-sun-halo weather-sun-halo-outer"></div>
      <div class="weather-sun-halo weather-sun-halo-inner"></div>
      <svg class="weather-sun-rays" viewBox="0 0 200 200" fill="none">
        <path d="M100 13v14m0 146v14M13 100h14m146 0h14M38.5 38.5l10 10m103 103 10 10m0-123-10 10m-103 103-10 10M66.7 19.6l5.4 13m55.8 134.8 5.4 13M19.6 133.3l13-5.4m134.8-55.8 13-5.4M19.6 66.7l13 5.4m134.8 55.8 13 5.4M66.7 180.4l5.4-13m55.8-134.8 5.4-13" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <div class="weather-sun-disc"></div>
    </div>
    <div class="weather-moon">
      <svg viewBox="0 0 160 160" fill="none">
        <path d="M124.6 106.6A58 58 0 0 1 61.1 22a59 59 0 1 0 63.5 84.6Z" fill="currentColor"/>
        <path d="M48 73a40 40 0 0 0 26 51" stroke="#fff9e9" stroke-opacity=".3" stroke-width="3" stroke-linecap="round"/>
        <circle cx="43" cy="93" r="5" fill="#d6e8d9" fill-opacity=".45"/>
        <circle cx="62" cy="117" r="3" fill="#d6e8d9" fill-opacity=".45"/>
      </svg>
    </div>
  </div>

  <div class="weather-cloud weather-cloud-back">
    <svg viewBox="0 0 310 135" fill="none"><path d="M55 124C24 124 9 108 9 86c0-24 21-42 47-42 8-22 28-35 52-35 31 0 54 18 61 45 8-6 18-9 29-9 25 0 42 15 46 35 7-3 14-4 21-3 23 1 36 11 36 24 0 15-14 23-35 23H55Z" fill="currentColor"/></svg>
  </div>
  <div class="weather-cloud weather-cloud-front">
    <svg viewBox="0 0 310 135" fill="none"><path d="M55 124C24 124 9 108 9 86c0-24 21-42 47-42 8-22 28-35 52-35 31 0 54 18 61 45 8-6 18-9 29-9 25 0 42 15 46 35 7-3 14-4 21-3 23 1 36 11 36 24 0 15-14 23-35 23H55Z" fill="currentColor"/><path d="M61 109h171" stroke="var(--weather-cloud-line)" stroke-width="3" stroke-linecap="round" opacity=".45"/></svg>
  </div>
  <div class="weather-rain">
    {drops.map((drop) => <i style={`--i:${drop};--x:${14 + (drop * 17) % 76}%`}></i>)}
  </div>
  <div class="weather-snow">
    {flakes.map((flake) => <i style={`--i:${flake};--x:${9 + (flake * 19) % 84}%`}></i>)}
  </div>
  <svg class="weather-lightning" viewBox="0 0 66 110" fill="none"><path d="m38 3-32 58h25l-8 46 37-63H35L46 3h-8Z" fill="currentColor"/></svg>
  <div class="weather-fog"><i></i><i></i><i></i></div>

  <div class="weather-coast">
    <svg class="weather-mountains" viewBox="0 0 1200 260" preserveAspectRatio="none" fill="none">
      <path d="M0 212c72-4 124-42 182-45 66-4 83-69 157-65 37 2 68 31 103 35 53 6 91-77 163-77 68 0 93 43 145 47 57 4 108-95 176-95 61 0 97 85 144 87 45 2 83-9 130-29v190H0v-48Z" fill="var(--weather-mountain-back)"/>
      <path d="M0 229c97 8 130-46 218-31 88 14 133-42 198-33 89 12 100 45 174 29 74-16 94-44 172-30 78 13 107-39 177-29 81 11 138 45 261 14v111H0v-31Z" fill="var(--weather-mountain-front)"/>
    </svg>
    <div class="weather-sea">
      <svg class="weather-wave weather-wave-back" viewBox="0 0 1440 90" preserveAspectRatio="none" fill="none"><path d="M0 28C120 0 240 0 360 28s240 28 360 0 240-28 360 0 240 28 360 0v62H0V28Z" fill="currentColor"/></svg>
      <svg class="weather-wave weather-wave-front" viewBox="0 0 1440 90" preserveAspectRatio="none" fill="none"><path d="M0 30C120 8 240 8 360 30s240 22 360 0 240-22 360 0 240 22 360 0v60H0V30Z" fill="currentColor"/></svg>
      <div class="weather-reflection"><i></i><i></i><i></i></div>
    </div>
    <svg class="weather-sailboat" viewBox="0 0 100 120" fill="none"><path d="M52 7v87" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="m46 15-34 66h34V15Zm12 24v42h28L58 39Z" fill="var(--weather-sail)"/><path d="M5 94h89l-12 15H20L5 94Z" fill="currentColor"/></svg>
  </div>
  <svg class="weather-birds" viewBox="0 0 140 65" fill="none"><path d="M8 34c7-7 14-7 21 0 7-7 14-7 21 0M82 12c5-5 10-5 15 0 5-5 10-5 15 0m-54 41c4-4 8-4 12 0 4-4 8-4 12 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
</div>

<style>
  .weather-scene {
    --weather-cloud-back: #e2ebe3;
    --weather-cloud-front: #fffdf5;
    --weather-cloud-line: #c4d7c8;
    --weather-mountain-back: #c5d8bd;
    --weather-mountain-front: #9ebfa4;
    --weather-water-back: #a2cec2;
    --weather-water-front: #77b8ad;
    --weather-sail: #fff7dc;
    --weather-sun-opacity: 1;
    --weather-moon-opacity: 0;
    --weather-cloud-opacity: 0;
    --weather-rain-opacity: 0;
    --weather-snow-opacity: 0;
    --weather-fog-opacity: 0;
    --weather-star-opacity: 0;
    --weather-bird-opacity: .65;
    position: absolute;
    inset: 0;
    overflow: hidden;
    isolation: isolate;
    pointer-events: none;
    border-radius: inherit;
    contain: layout paint;
  }
  .weather-sky-glow { position: absolute; inset: 0; background: radial-gradient(ellipse at 76% 29%, #fff3c6a8 0, #fff3c600 50%); transition: opacity .65s; }
  .weather-orbit { position: absolute; width: clamp(120px, 28%, 250px); aspect-ratio: 1; right: 15%; top: 8%; }
  .weather-sun, .weather-moon { position: absolute; inset: 0; transition: opacity .65s ease, transform .9s ease; }
  .weather-sun { opacity: var(--weather-sun-opacity); transform: translateY(calc((1 - var(--weather-sun-opacity)) * 20px)); }
  .weather-sun-disc { position: absolute; inset: 25%; border-radius: 50%; background: linear-gradient(145deg, #ffcf70, #ef955c); box-shadow: inset 0 0 0 1px #fff4cf80, 0 0 35px #f5bc6540; }
  .weather-sun-halo { position: absolute; border-radius: 50%; border: 1px solid #eec37b38; animation: weather-breathe 6s ease-in-out infinite; }
  .weather-sun-halo-outer { inset: -8%; animation-delay: -3s; }
  .weather-sun-halo-inner { inset: 9%; background: #ffcc6b0a; }
  .weather-sun-rays { position: absolute; inset: 0; width: 100%; height: 100%; color: #e4a65d; animation: weather-orbit 90s linear infinite; }
  .weather-moon { opacity: var(--weather-moon-opacity); color: #fff5ce; transform: rotate(-8deg); }
  .weather-moon svg { width: 100%; height: 100%; }
  .weather-stars { position: absolute; inset: 0; opacity: var(--weather-star-opacity); transition: opacity .65s; }
  .weather-stars i { position: absolute; left: var(--x); top: var(--y); width: 3px; height: 3px; border-radius: 50%; background: #f8e8b9; animation: weather-twinkle 4s ease-in-out infinite; animation-delay: calc(var(--i) * -.63s); }
  .weather-stars i:nth-child(3n) { width: 5px; height: 5px; }
  .weather-cloud { position: absolute; width: clamp(150px, 36%, 340px); opacity: var(--weather-cloud-opacity); transition: opacity .65s, color .65s; }
  .weather-cloud svg { width: 100%; height: auto; display: block; }
  .weather-cloud-back { right: 2%; top: 18%; color: var(--weather-cloud-back); animation: weather-cloud-back 17s ease-in-out infinite alternate; }
  .weather-cloud-front { right: 23%; top: 25%; color: var(--weather-cloud-front); animation: weather-cloud-front 13s ease-in-out infinite alternate; }
  .weather-rain, .weather-snow { position: absolute; right: 12%; top: 39%; width: 45%; height: 37%; overflow: hidden; opacity: var(--weather-rain-opacity); transition: opacity .65s; }
  .weather-rain i { position: absolute; left: var(--x); top: -25%; height: 19px; width: 2px; border-radius: 99px; background: #679caa; transform: rotate(15deg); animation: weather-rainfall 1.15s linear infinite; animation-delay: calc(var(--i) * -.17s); }
  .weather-rain i:nth-child(3n) { height: 13px; opacity: .6; }
  .weather-snow { opacity: var(--weather-snow-opacity); }
  .weather-snow i { position: absolute; left: var(--x); top: -15%; width: 5px; height: 5px; border-radius: 50%; background: #f8ffff; box-shadow: 0 0 0 1px #a4bbc43b; animation: weather-snowfall 5.2s linear infinite; animation-delay: calc(var(--i) * -.61s); }
  .weather-snow i:nth-child(2n) { width: 3px; height: 3px; animation-duration: 6.7s; }
  .weather-lightning { position: absolute; width: 38px; height: 65px; right: 29%; top: 43%; opacity: 0; color: #eac76b; }
  .weather-fog { position: absolute; right: 6%; top: 42%; width: 55%; height: 25%; opacity: var(--weather-fog-opacity); transition: opacity .65s; }
  .weather-fog i { position: absolute; height: 7px; border-radius: 99px; background: #e0e7dbb3; width: 85%; left: 0; top: 10%; animation: weather-fog-drift 10s ease-in-out infinite alternate; }
  .weather-fog i:nth-child(2) { left: 12%; top: 40%; width: 76%; animation-delay: -5s; }
  .weather-fog i:nth-child(3) { left: 4%; top: 70%; width: 65%; animation-delay: -2s; }
  .weather-coast { position: absolute; bottom: 0; right: 0; width: 100%; height: 36%; }
  .weather-mountains { position: absolute; width: 100%; height: 100%; bottom: 18%; right: 0; }
  .weather-sea { position: absolute; bottom: 0; right: 0; width: 100%; height: 56%; }
  .weather-wave { position: absolute; width: 200%; height: 100%; bottom: -20%; left: -50%; }
  .weather-wave-back { color: var(--weather-water-back); animation: weather-wave-flow 13s ease-in-out infinite alternate; }
  .weather-wave-front { bottom: -44%; color: var(--weather-water-front); animation: weather-wave-flow 9s ease-in-out -3s infinite alternate-reverse; }
  .weather-reflection { position: absolute; width: 14%; height: 68%; top: 3%; right: 29%; opacity: calc(var(--weather-sun-opacity) * .6 + var(--weather-moon-opacity) * .45); }
  .weather-reflection i { position: absolute; height: 2px; width: 80%; left: 10%; top: 14%; border-radius: 99px; background: #fff8dc; animation: weather-reflection 4s ease-in-out infinite alternate; }
  .weather-reflection i:nth-child(2) { width: 58%; left: 21%; top: 43%; animation-delay: -1s; }
  .weather-reflection i:nth-child(3) { width: 38%; left: 31%; top: 72%; animation-delay: -2s; }
  .weather-sailboat { position: absolute; width: clamp(25px, 6%, 58px); right: 15%; bottom: 14%; color: #486f64; transform-origin: 50% 90%; animation: weather-boat-bob 5s ease-in-out infinite; }
  .weather-birds { position: absolute; width: 15%; max-width: 130px; right: 45%; top: 16%; color: #729584; opacity: var(--weather-bird-opacity); animation: weather-birds-glide 14s ease-in-out infinite alternate; transition: opacity .65s; }

  :global([data-weather-widget][data-weather-kind='clear-night']) .weather-scene,
  :global([data-weather-widget][data-weather-kind='partly-cloudy-night']) .weather-scene {
    --weather-sun-opacity: 0; --weather-moon-opacity: 1; --weather-star-opacity: 1; --weather-bird-opacity: 0;
    --weather-cloud-back: #a4bdc5; --weather-cloud-front: #c5d5d8; --weather-cloud-line: #8aaab2;
    --weather-mountain-back: #a5b9b6; --weather-mountain-front: #789d98; --weather-water-back: #82b0b0; --weather-water-front: #5d959c;
  }
  :global([data-weather-widget][data-weather-kind='clear-night']) .weather-sky-glow,
  :global([data-weather-widget][data-weather-kind='partly-cloudy-night']) .weather-sky-glow { background: radial-gradient(ellipse at 77% 28%, #486e9a66 0, #6386a11f 34%, #6386a100 72%); }
  :global([data-weather-widget][data-weather-kind='partly-cloudy-day']) .weather-scene,
  :global([data-weather-widget][data-weather-kind='partly-cloudy-night']) .weather-scene { --weather-cloud-opacity: 1; }
  :global([data-weather-widget][data-weather-kind='partly-cloudy-day']) .weather-cloud-back,
  :global([data-weather-widget][data-weather-kind='partly-cloudy-night']) .weather-cloud-back { opacity: .65; }
  :global([data-weather-widget][data-weather-kind='cloudy']) .weather-scene,
  :global([data-weather-widget][data-weather-kind='fog']) .weather-scene,
  :global([data-weather-widget][data-weather-kind='drizzle']) .weather-scene,
  :global([data-weather-widget][data-weather-kind='rain']) .weather-scene,
  :global([data-weather-widget][data-weather-kind='snow']) .weather-scene,
  :global([data-weather-widget][data-weather-kind='thunderstorm']) .weather-scene,
  :global([data-weather-widget][data-weather-kind='unknown']) .weather-scene {
    --weather-sun-opacity: 0; --weather-cloud-opacity: 1; --weather-bird-opacity: 0;
    --weather-cloud-back: #bdcecb; --weather-cloud-front: #e0e8df;
  }
  :global([data-weather-widget][data-weather-kind='cloudy']) .weather-sky-glow,
  :global([data-weather-widget][data-weather-kind='fog']) .weather-sky-glow,
  :global([data-weather-widget][data-weather-kind='drizzle']) .weather-sky-glow,
  :global([data-weather-widget][data-weather-kind='rain']) .weather-sky-glow,
  :global([data-weather-widget][data-weather-kind='snow']) .weather-sky-glow,
  :global([data-weather-widget][data-weather-kind='thunderstorm']) .weather-sky-glow,
  :global([data-weather-widget][data-weather-kind='unknown']) .weather-sky-glow { opacity: 0; }
  :global([data-weather-widget][data-weather-kind='fog']) .weather-scene { --weather-fog-opacity: 1; --weather-cloud-opacity: .55; --weather-mountain-back: #d3ddd0; --weather-mountain-front: #bdcfba; }
  :global([data-weather-widget][data-weather-kind='drizzle']) .weather-scene { --weather-rain-opacity: .55; }
  :global([data-weather-widget][data-weather-kind='drizzle']) .weather-rain i { animation-duration: 1.8s; height: 10px; }
  :global([data-weather-widget][data-weather-kind='rain']) .weather-scene { --weather-rain-opacity: .85; --weather-water-front: #77a8a5; }
  :global([data-weather-widget][data-weather-kind='snow']) .weather-scene { --weather-snow-opacity: 1; --weather-mountain-back: #d1ded6; --weather-mountain-front: #b5cfc6; }
  :global([data-weather-widget][data-weather-kind='thunderstorm']) .weather-scene { --weather-rain-opacity: .9; --weather-cloud-back: #8da5a5; --weather-cloud-front: #b3c3bc; --weather-cloud-line: #829c98; --weather-mountain-back: #afc4bb; --weather-mountain-front: #8bab9f; }
  :global([data-weather-widget][data-weather-kind='thunderstorm']) .weather-lightning { animation: weather-lightning-flash 7s linear infinite; }

  @keyframes weather-orbit { to { transform: rotate(360deg); } }
  @keyframes weather-breathe { 0%, 100% { transform: scale(.95); opacity: .45; } 50% { transform: scale(1.05); opacity: 1; } }
  @keyframes weather-cloud-back { from { transform: translateX(-7%); } to { transform: translateX(7%); } }
  @keyframes weather-cloud-front { from { transform: translateX(5%) translateY(0); } to { transform: translateX(-5%) translateY(4%); } }
  @keyframes weather-rainfall { from { transform: translate(14px, -20px) rotate(15deg); opacity: 0; } 12% { opacity: .9; } 85% { opacity: .9; } to { transform: translate(-28px, 200px) rotate(15deg); opacity: 0; } }
  @keyframes weather-snowfall { from { transform: translate(0, -10px); opacity: 0; } 15% { opacity: .9; } 80% { opacity: .9; } to { transform: translate(25px, 200px); opacity: 0; } }
  @keyframes weather-fog-drift { from { transform: translateX(-5%); } to { transform: translateX(5%); } }
  @keyframes weather-wave-flow { from { transform: translateX(-5%); } to { transform: translateX(5%); } }
  @keyframes weather-boat-bob { 0%, 100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-4px) rotate(3deg); } }
  @keyframes weather-reflection { from { transform: scaleX(.75); opacity: .4; } to { transform: scaleX(1); opacity: .9; } }
  @keyframes weather-birds-glide { from { transform: translate(-10px, 0); } to { transform: translate(12px, -4px); } }
  @keyframes weather-twinkle { 0%, 100% { opacity: .35; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.1); } }
  @keyframes weather-lightning-flash { 0%, 74%, 78%, 82%, 100% { opacity: 0; } 75%, 77% { opacity: .9; } 80% { opacity: .6; } }

  @media (prefers-reduced-motion: reduce) {
    .weather-scene *, .weather-scene *::before, .weather-scene *::after { animation: none !important; transition: none !important; }
    .weather-rain i { top: calc(7% + var(--i) * 6%); }
    .weather-snow i { top: calc(6% + var(--i) * 7%); }
    :global([data-weather-widget][data-weather-kind='thunderstorm']) .weather-lightning { opacity: .65; }
  }
</style>
