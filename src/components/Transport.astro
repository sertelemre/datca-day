---
import Icon from './Icon.astro';
import { getLocale, localePath } from '../lib/i18n';
import { transportPath, type Locale } from '../lib/paths';
import { dayLabel, formatDate, kinds, localizedNote, placeName, transportCopy, transportRoutes } from '../lib/transport';

interface Props { locale?:Locale; routeSlug?:string }
const {locale = getLocale(Astro.url.pathname), routeSlug} = Astro.props;
const t = transportCopy(locale);
const route = transportRoutes.find(item => item.slug === routeSlug);
if (routeSlug && !route) throw new Error('Transport route missing: ' + routeSlug);
const hub = localePath('/ulasim',locale);
const checked = route?.checked || transportRoutes[0].checked;
const icons = {airport:'compass', ferry:'boat', local:'pin', intercity:'compass'};
const related = route?.kind === 'ferry' ? ['datca-karakoy-9-8'] :
  route?.kind === 'airport' ? ['datca-marmaris-48-16'] :
  route?.code === '48-16' ? ['marmaris-dalaman-havas','marmaris-otogar-dalaman-havalimani-48-26'] :
  route?.code === '9-8' ? ['bodrum-datca-48-48'] : [];
const title = route ? placeName(route.title, locale).replace(' - ', ' ↔ ') : t('title');
const sourceUrl = route?.code === 'Havaş' && locale !== 'tr' ? 'https://havas.net/en/bus-services#bus-service-2' : route?.source;
---
<div class="transport container" data-transport-root data-checked={checked}>
  <nav class="breadcrumbs" aria-label={t('name')}><a href={localePath('/',locale)}>{t('home')}</a><span>›</span>{route ? <><a href={hub}>{t('name')}</a><span>›</span><span>{route.code}</span></> : <span>{t('name')}</span>}</nav>
  <header class:list={["transport-intro",{"hub-intro":!route}]}>
    <span class="eyebrow">{route ? <><Icon name={icons[route.kind]} size={15}/>{t(route.kind)} · {route.code}</> : <><Icon name="compass" size={15}/>Datça · Muğla</>}</span>
    <h1>{title}</h1>
    <p>{!route ? t('intro') : route.kind === 'airport' ? t('transfer') : route.kind === 'ferry' ? t('port') : t('aboutTimes')}</p>
  </header>
  <p data-stale hidden class="transport-notice">{t('older')}</p>
  {!route ? <>
    <div class="transport-tools">
      <label class="search-field"><span>{t('search')}</span><span class="search-box"><Icon name="search" size={18}/><input type="search" data-route-search placeholder={t('examples')}/></span></label>
      <nav aria-label={t('name')} class="transport-jump">{kinds.map(kind=><a href={'#'+kind}>{t(kind)}</a>)}</nav>
    </div>
    <p hidden data-no-routes role="status">{t('noMatch')}</p>
    {kinds.map(kind=><section class="transport-group" id={kind} data-group>
      <h2>{t(kind)}</h2>
      {kind === 'airport' && <p>{t('transfer')}</p>}
      {kind === 'ferry' && <p>{t('port')}</p>}
      <div class="route-grid">{transportRoutes.filter(item=>item.kind===kind).sort((a,b)=>Number(b.code==='48-16')-Number(a.code==='48-16')).map(item=><a class="route-card" href={transportPath(item.slug,locale)} data-route-card data-search={[item.code,item.title,placeName(item.title,locale),item.via].join(' ')}>
        <span class="route-code">{item.code}</span><span><strong>{placeName(item.title,locale).replace(' - ',' ↔ ')}</strong><small>{item.days.length ? t('hours') : t('noDataLink')}</small></span><Icon name="arrow" size={17}/>
      </a>)}</div>
    </section>)}
    <footer class="transport-meta"><p>{t('aboutTimes')}</p><span>{t('asOf')} · <time datetime={checked}>{formatDate(checked,locale)}</time></span></footer>
  </> : <>
    <section class="transport-panel">
      <div class="transport-panel-head"><div><span class="eyebrow"><Icon name="clock" size={15}/>{route.code === 'Havaş' ? 'Havaş' : 'MUTTAŞ'}</span><h2>{t('hours')}</h2></div><a class="text-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">{t('official')}<Icon name="external" size={15}/></a></div>
      {route.days.some(day=>day.date) && <p>{t('dateLimited')}</p>}
      {!route.days.length && <p class="empty">{t('noTimes')}</p>}
      {route.days.map((day,idx)=><details class="schedule-day" data-day={day.date || day.label} open={idx===0}>
        <summary><Icon name="calendar" size={17}/><strong>{dayLabel(day,locale)}</strong><Icon name="down" size={17}/></summary>
        <div class="direction-grid">{day.directions.map(direction=><div class="departures">
          <span class="departure-label">{t('departures')}</span><h3>{placeName(direction.from,locale)}</h3>
          {direction.times.length > 0 && <ul>{direction.times.map(time=><li><time>{time}</time>{direction.annotations?.[time] && <sup aria-hidden="true">*</sup>}</li>)}</ul>}
          {direction.flight && <p>{t('flight')}</p>}
          {direction.note && <p>{localizedNote(direction.note,locale)}</p>}
          {!direction.times.length && !direction.note && !direction.flight && <p>{t('noDirection')}</p>}
          {Object.entries(direction.annotations || {}).map(([time,note])=><small class="time-note">* {time} · {localizedNote(note,locale)}</small>)}
        </div>)}</div>
      </details>)}
      <footer class="transport-meta">
        <span>{t('asOf')} · <time datetime={checked}>{formatDate(checked,locale)}</time></span>
        {route.sourceUpdated && <span>{t('sourceUpdate')} · <time datetime={route.sourceUpdated}>{formatDate(route.sourceUpdated,locale)}</time></span>}
        {route.via && <p><strong>{t('stops')}</strong> · {placeName(route.via.replaceAll(/\s*-\s*/g,' – '),locale)}</p>}
        {route.kind === 'ferry' && <p>{t('ferryInfo')} · <a href="tel:+902523160882">+90 252 316 08 82</a></p>}
      </footer>
    </section>
    {related.length > 0 && <section class="related"><h2>{t('connections')}</h2>{transportRoutes.filter(item=>related.includes(item.slug)).map(item=><a class="text-link" href={transportPath(item.slug,locale)}>{item.code} · {placeName(item.title,locale)} <Icon name="arrow" size={16}/></a>)}</section>}
    <a class="back-link text-link" href={hub}>{t('all')} <Icon name="arrow" size={16}/></a>
  </>}
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-transport-root]');
  if (root) {
    const now = new Date();
    const today = new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Istanbul'}).format(now);
    const weekDay = new Intl.DateTimeFormat('tr',{timeZone:'Europe/Istanbul',weekday:'long'}).format(now);
    const age = (Date.parse(today) - Date.parse(root.dataset.checked!)) / 86400000;
    const stale = root.querySelector<HTMLElement>('[data-stale]');
    if (stale && age > 7) stale.hidden = false;
    const days = [...root.querySelectorAll<HTMLDetailsElement>('details[data-day]')];
    const match = days.find(day => [today,weekDay].includes(day.dataset.day!)) ||
      days.find(day => day.dataset.day === 'Hafta İçi' && !['Cumartesi','Pazar'].includes(weekDay));
    if (match) days.forEach(day=>{day.open = day===match;});
    const input = root.querySelector<HTMLInputElement>('[data-route-search]');
    const normalize = (value:string) => value.toLocaleLowerCase('tr').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replaceAll('ı','i');
    input?.addEventListener('input',()=>{
      const query = normalize(input.value.trim());
      let total = 0;
      root.querySelectorAll<HTMLElement>('[data-group]').forEach(group=>{
        let count = 0;
        group.querySelectorAll<HTMLElement>('[data-route-card]').forEach(card=>{
          card.hidden = !normalize(card.dataset.search || '').includes(query);
          if (!card.hidden) count++;
        });
        group.hidden = !count;
        total += count;
      });
      const empty = root.querySelector<HTMLElement>('[data-no-routes]');
      if (empty) empty.hidden = total > 0;
    });
  }
</script>
<style>
.transport{padding-block:22px 75px}.transport [hidden]{display:none}.transport .breadcrumbs{display:flex;gap:9px;align-items:center;color:var(--muted);font-size:13px;flex-wrap:wrap}.transport-intro{padding:40px 0 28px}.transport-intro .eyebrow,.transport-panel-head .eyebrow{display:flex;align-items:center;gap:8px}.transport-intro h1{font-size:clamp(36px,6vw,67px);margin:13px 0 12px;line-height:1.06}.transport-intro p,.transport-group>p,.transport-panel>p{max-width:75ch;line-height:1.65;color:var(--muted)}.transport-tools,.transport-panel{border:1px solid var(--line);background:var(--paper);padding:clamp(18px,3vw,32px);border-radius:12px}.transport-tools{display:grid;gap:16px}.search-field{display:grid;gap:6px;font-size:14px;font-weight:700}.search-box{display:flex;align-items:center;gap:9px;border:1px solid var(--line);padding:9px 13px;border-radius:6px;background:white;max-width:490px}.search-box input{width:100%;min-width:0;color:var(--ink);font:inherit;font-weight:400;background:transparent;border:0}.search-box:focus-within{outline:2px solid var(--green)}.search-box input:focus{outline:0}.transport-jump{display:flex;gap:8px;flex-wrap:wrap}.transport-jump a,.route-code{background:#edf1e8;color:var(--green);border-radius:5px;padding:7px 10px;font-weight:700;font-size:13px}.transport-group{padding-top:32px;scroll-margin-top:85px}.transport h2{font-size:clamp(25px,3vw,38px);margin:0 0 14px}.transport-group>p{margin:0 0 14px}.route-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,310px),1fr));gap:10px}.route-card{min-width:0;display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:8px;padding:14px;background:var(--paper);color:var(--green)}.route-card:hover,.transport-jump a:hover{border-color:var(--green);background:#f2f5ed}.route-card strong{display:block;line-height:1.35}.route-card small{color:var(--muted);font-size:12px}.route-code{white-space:nowrap}.route-card>svg:last-child{margin-left:auto;flex-shrink:0}.transport-panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.transport-panel-head h2{margin:8px 0}.schedule-day{border-top:1px solid var(--line)}.schedule-day summary{display:flex;align-items:center;gap:10px;cursor:pointer;padding:16px 2px;list-style:none}.schedule-day summary::-webkit-details-marker{display:none}.schedule-day summary svg:last-child{margin-left:auto}.schedule-day[open] summary svg:last-child{transform:rotate(180deg)}.direction-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding-bottom:20px}.departures{background:#f3f5ee;border-radius:8px;padding:15px}.departure-label{color:var(--muted);font-size:12px}.departures h3{font-size:22px;margin:3px 0 10px}.departures ul{padding:0;margin:0;display:flex;flex-wrap:wrap;gap:5px;list-style:none}.departures li{position:relative;display:inline-flex;align-items:baseline;background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:4px 7px;font-variant-numeric:tabular-nums;font-size:14px}.departures sup{font-size:11px}.time-note{display:block;margin-top:6px;color:var(--muted);line-height:1.5}.departures p,.empty{line-height:1.6}.transport-meta{padding-top:20px;margin-top:8px;border-top:1px solid var(--line);color:var(--muted);font-size:13px;line-height:1.6}.transport-meta span{display:inline-block;margin-right:16px}.transport-meta p{margin:7px 0;overflow-wrap:anywhere}.transport-meta a{text-decoration:underline}.related{margin-top:28px}.related a{display:flex;width:fit-content;margin:8px 0}.transport-notice{padding:12px 16px;border-left:3px solid var(--orange);background:#fff3e7}.back-link{margin-top:24px}.transport-panel>p{margin:8px 0 18px}@media(max-width:640px){.direction-grid{grid-template-columns:1fr}.transport-intro{padding-top:30px}.transport-panel-head{align-items:flex-start}.transport-jump{gap:6px}.route-card{padding:12px}}
@media(max-width:600px){
  .transport{padding-top:12px}.transport-intro{padding:12px 0}.transport-intro h1{margin:4px 0 8px;font-size:34px}
  .hub-intro .eyebrow,.hub-intro p{display:none}.transport-intro p{font-size:14px;line-height:1.5}
  .transport-tools{padding:12px}.transport-jump{display:flex;flex-wrap:nowrap;overflow:auto;scrollbar-width:thin}
  .transport-jump a{white-space:nowrap;flex:none;min-height:44px}.transport-group{margin-top:20px}
}
</style>
