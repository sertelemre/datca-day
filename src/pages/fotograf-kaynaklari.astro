---
import { ui } from '../lib/ui';
import { getLocale } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = ui(locale);

import Layout from '../layouts/Layout.astro';
import { photoCaption } from '../lib/photo-caption';
import { photos } from '../lib/photos';
---
<Layout title={t("Fotoğraf kaynakları, yazarlar ve kullanım lisansları")} description={t("datca.day’de kullanılan gerçek Datça ve çevre fotoğraflarının yazarları, Wikimedia Commons kaynakları ve açık kullanım lisansları.")}><section class="container section"><span class="eyebrow">{t("GERÇEK YERLER, AÇIK KAYNAKLAR")}</span><h1 class="credits-title">{t("Datça’yı gösteren")}<br/><em>{t("karelerin arkasında.")}</em></h1><p class="credits-intro">{t("Fotoğraflar Wikimedia Commons’tan, her dosyanın kullanım lisansı kontrol edilerek seçildi. Lisanslar fotoğraflara aittir; yazar ve özgün dosya bağlantıları aşağıdadır. Görseller yeniden boyutlandırıldı ve WebP biçimine dönüştürüldü. CC BY-SA görsel uyarlamaları ilgili aynı lisansla sunulur.")}</p><p class="credits-intro">{t("Görsellerin kadrajı ve boyutu farklı ekranlar ve paylaşım kartları için uyarlandı.")}</p><div class="credits-grid">{photos.map(photo=><article id={photo.file.split("/").pop()?.split(".")[0]}><img src={photo.file} alt={photoCaption(photo.file,locale)} width={640} height={440} loading="lazy"/><div><h2>{photoCaption(photo.file,locale)}</h2><p>{photo.title}</p><p>{t("Fotoğraf:")} {photo.author}</p><p><a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">{photo.license}</a> · <a href={photo.source} target="_blank" rel="noopener noreferrer">{t("Özgün dosya ve kayıt")}</a></p></div></article>)}</div></section></Layout>
<style>.credits-title{font-size:clamp(44px,6vw,70px);line-height:1.07;margin:20px 0 25px}.credits-intro{max-width:770px;font-size:14px;color:var(--muted);line-height:1.9;margin-bottom:35px}.credits-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.credits-grid article{border:1px solid var(--line);border-radius:6px;overflow:hidden}.credits-grid img{width:100%;height:210px;object-fit:cover}.credits-grid article>div{padding:20px}.credits-grid h2{font-size:25px;line-height:1.1;margin-bottom:14px}.credits-grid p{font-size:11px;color:var(--muted);line-height:1.7}.credits-grid a{color:var(--orange);text-decoration:underline}.credits-changes{margin-top:8px;font-size:9px!important}@media(max-width:800px){.credits-grid{grid-template-columns:1fr 1fr}}@media(max-width:500px){.credits-grid{grid-template-columns:1fr}}</style>
