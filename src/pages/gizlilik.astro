---
import { ui } from '../lib/ui';
import { getLocale, localePath } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = ui(locale);
const localize = (path: string) => localePath(path, locale);

import Layout from '../layouts/Layout.astro';
import { getWeatherCopy } from '../lib/weather-copy';
const analyticsPrivacy = {
 tr: { title: 'İsteğe bağlı ziyaret ölçümü', text: 'İzin verirsen Google Analytics sayfa görüntülemelerini ve bilet, telefon, yol tarifi ve kaynak bağlantısı tıklamalarını ölçer. Google’a sayfa yolu, sayfa dili, içerik tanımlayıcısı ve tarayıcı/bağlantı bilgileri iletilir. Reklam kişiselleştirmesi kapalıdır. Arama metnin, form içeriğin, tatil planın ve kaydettiğin yerler bu ölçüme dahil edilmez.', choice: 'İzin vermeden Google Analytics yüklenmez. Tercihin bu tarayıcıda 180 gün saklanır; sayfa altındaki Çerez tercihleri düğmesinden değiştirebilirsin. İzin geri çekilince yeni ölçümler durur ve bu sitedeki Analytics çerezleri temizlenir. Önceden işlenen veriler otomatik silinmez.', link: 'Google verileri nasıl kullanır?' },
 en: { title: 'Optional visit measurement', text: 'With your permission, Google Analytics measures page views and clicks on ticket, phone, directions and source links. Page path, language, content identifier and browser/connection information are sent to Google. Advertising personalisation is disabled. Search text, form contents, your trip plan and saved places are excluded from this measurement.', choice: 'Google Analytics does not load before permission. Your choice is stored in this browser for 180 days; change it using Cookie preferences at the bottom of the page. Withdrawing permission stops new measurements and clears this site’s Analytics cookies. Previously processed data is not automatically deleted.', link: 'How Google uses data' },
 ru: { title: 'Необязательная статистика посещений', text: 'С вашего разрешения Google Analytics измеряет просмотры страниц и нажатия на билеты, телефон, маршрут и ссылки на источники. Google получает путь страницы, язык, идентификатор материала и сведения о браузере и подключении. Персонализация рекламы отключена. Текст поиска, содержимое форм, ваш план поездки и сохранённые места в эту статистику не входят.', choice: 'До разрешения Google Analytics не загружается. Выбор хранится в этом браузере 180 дней; его можно изменить кнопкой «Настройки cookies» внизу страницы. Отзыв разрешения останавливает новые измерения и удаляет cookies Analytics этого сайта. Ранее обработанные данные автоматически не удаляются.', link: 'Как Google использует данные' },
}[locale];
---
<Layout title={t("Gizlilik ve tarayıcıda saklanan tatil kayıtları")} description={t("datca.day’de kaydedilen yerler ve tatil planı tarayıcında tutulur. Yerel kayıtlar, dış bağlantılar ve fotoğraf kaynakları hakkında bilgi al.")}><section class="container section" style="max-width:800px"><span class="eyebrow">DATCA.DAY</span><h1 style="font-size:clamp(34px,6vw,58px);margin:15px 0 30px">{t("Gizlilik ve yerel kayıtlar")}</h1><div style="display:grid;gap:24px"><p>{t("Bu sitede kaydettiğin yerler ve oluşturduğun tatil planı, kullandığın tarayıcının yerel depolama alanında tutulur. Bu veriler bir sunucuya gönderilmez. Farklı cihazlar arasında otomatik olarak eşitlenmez.")}</p><p>{t("Kaydedilen yerlerini ilgili sayfadan temizleyebilir, tatil planındaki günleri kaldırabilirsin. Tarayıcı verilerini temizlemek de bu kayıtları siler.")}</p>{import.meta.env.PUBLIC_CONTACT_FORM_URL && <p>{t("İletişim formunu gönderdiğinde adın, e-posta adresin ve mesajın Polybase üzerinden iletilir. Bu hizmetin kendi gizlilik koşulları geçerlidir.")}</p>}<p>{t("Harita, feribot, resmî kurum ve kaynak bağlantıları farklı sitelere açılır. Konaklama kartlarındaki fotoğraflar tesisin veya kartta belirtilen kataloğun görsel sunucusundan yüklenir. Bu sağlayıcılar IP adresini ve tarayıcı bilgilerini alabilir. Yerel olarak sunduğumuz Datça manzaralarının yazar ve lisans bilgileri")} <a class="text-link" href={localize("/fotograf-kaynaklari")}>{t("fotoğraf kaynaklarında")}</a> {t("bulunur.")}</p><p>{t('Etkinlik afişleri görüntülendiğinde tarayıcın ilgili afiş sunucusuna bağlanır. Sağlayıcı IP adresini ve tarayıcı bilgilerini alabilir.')}</p><p>{t('Taksi, sağlık ve konaklama haritalarını görüntülediğinde tarayıcın harita görüntülerini OpenStreetMap sunucularından alır. Yol tarifi bağlantısı Google Haritalar’da açılır.')}</p><p>{getWeatherCopy(locale).privacy} <a class="text-link" href="https://open-meteo.com/en/terms" target="_blank" rel="noopener noreferrer">Open-Meteo</a></p>{import.meta.env.PUBLIC_GA4_MEASUREMENT_ID && <section><h2>{analyticsPrivacy.title}</h2><p>{analyticsPrivacy.text}</p><p>{analyticsPrivacy.choice}</p><a class="text-link" href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">{analyticsPrivacy.link}</a></section>}<p>{t("Öneri paylaşmak için")} <a class="text-link" href={localize("/iletisim")}>{t("düzeltme kanalını")}</a> {t("kullanabilirsin. Hosting hizmetinin erişim kayıtları kendi işletme koşullarına bağlıdır.")}</p></div></section></Layout>
