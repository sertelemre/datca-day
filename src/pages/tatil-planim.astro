---
import { ui } from '../lib/ui';
import { getLocale, localePath } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = ui(locale);
const localize = (path: string) => localePath(path, locale);

import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout noindex title={t("Kişisel tatil planım")} description={t("Sevdiğin Datça rotalarını kaydet, kendi gün gün tatil planını oluştur.")}>
<section class="container page-intro"><div class="breadcrumbs"><a href={localize("/")}>{t("Ana sayfa")}</a><span>/</span><span>{t("Tatil planım")}</span></div><span class="eyebrow"><span class="tiny-line"></span> {t("BU TATİL SENİN HİKÂYEN")}</span><h1>{t("Benim")} <em>{t("Datça’m.")}</em></h1><p>{t("Biraz deniz, biraz keşif, biraz da boş zaman. Sevdiğin yerleri günlerine ekle, kendine ait bir tatil planı oluştur.")}</p></section>
<section class="container plan-workspace"><aside class="plan-picker"><div class="plan-picker-heading"><Icon name="compass" size={24}/><h2>{t("Rotana bir yer ekle")}</h2></div><label for="plan-search">{t("Bir yer veya deneyim ara")}</label><div class="plan-search"><Icon name="search" size={18}/><input id="plan-search" type="search" placeholder={t("Knidos, tekne, plaj…")} autocomplete="off"/></div><div class="plan-source"><button data-plan-source="all" aria-pressed="true">{t("Tüm keşifler")}</button><button data-plan-source="saved" aria-pressed="false">{t("Kaydettiklerim")} <Icon name="heart" size={13}/></button></div><p class="plan-picker-tip">{t("Bir güne dokun, sonra keşfini o güne ekle.")}</p><div id="plan-candidates" class="plan-candidates"></div><p class="plan-local-note"><Icon name="check" size={15}/> {t("Planın bu tarayıcıda otomatik kaydedilir.")}</p></aside><div class="plan-days-area"><div class="plan-toolbar"><span><Icon name="calendar" size={19}/><strong id="plan-day-count">{t("3 günlük tatil")}</strong></span><div><button class="text-link" id="plan-print">{t("Yazdır")} <Icon name="external" size={14}/></button><button class="button button-small" id="plan-add-day">{t("Gün ekle")} <Icon name="plus" size={15}/></button></div></div><div id="plan-days" class="plan-days"></div><div class="plan-ending"><Icon name="sun" size={32}/><span>{t("Her anı planlamak zorunda değilsin.")}<br/><em>{t("Güzel sürprizlere de yer kalsın.")}</em></span></div><p id="plan-status" role="status" aria-live="polite"></p></div></section>
<script src="../scripts/planner.ts"></script>
</Layout>
<style>
.plan-workspace{display:grid;grid-template-columns:330px 1fr;gap:40px;padding-bottom:85px;padding-top:5px}.plan-picker{background:#f0f1e8;border:1px solid var(--line);border-radius:7px;padding:25px;height:fit-content;position:sticky;top:25px}.plan-picker-heading{display:flex;align-items:center;gap:12px;margin-bottom:25px;color:var(--orange)}.plan-picker-heading h2{font-size:26px;color:var(--green);letter-spacing:-.5px}.plan-picker label{font-size:10px;color:var(--muted)}.plan-search{display:flex;align-items:center;gap:10px;margin-top:8px;border:1px solid var(--line);border-radius:4px;background:var(--paper);padding:10px}.plan-search input{width:100%;border:0;outline:0;background:none;color:var(--green);font-size:11px;min-width:0}.plan-source{display:flex;gap:6px;margin-top:14px}.plan-source button{font-size:9px;display:flex;align-items:center;gap:5px;padding:6px 9px;border:1px solid var(--line);border-radius:4px;background:none;color:var(--muted)}.plan-source button[aria-pressed=true]{background:var(--green);border-color:var(--green);color:white}.plan-picker-tip{font-size:9px;color:var(--muted);margin:18px 0 6px}.plan-candidates{max-height:425px;overflow-y:auto}.plan-local-note{display:flex;align-items:center;gap:8px;font-size:8px;color:var(--muted);margin-top:22px}.plan-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;gap:15px}.plan-toolbar>span,.plan-toolbar>div{display:flex;align-items:center;gap:13px}.plan-toolbar strong{font-weight:500;font-size:12px}.plan-toolbar .text-link{font-size:10px;gap:8px;cursor:pointer;background:none;border:0;padding:7px}.plan-days{display:flex;flex-direction:column;gap:18px}.plan-ending{display:flex;align-items:center;justify-content:center;gap:20px;padding:40px;color:var(--orange)}.plan-ending span{font-size:10px;color:var(--muted);line-height:2}.plan-ending em{font-family:var(--serif);font-size:20px;color:var(--green)}#plan-status{font-size:11px;color:var(--orange);text-align:center}
@media(max-width:900px){.plan-workspace{grid-template-columns:270px 1fr;gap:24px}.plan-picker{padding:20px}.plan-picker-heading h2{font-size:22px}}@media(max-width:650px){.plan-workspace{display:flex;flex-direction:column-reverse;gap:25px;padding-bottom:55px}.plan-picker{position:static;padding:23px}.plan-candidates{max-height:300px}.plan-toolbar{gap:10px}.plan-toolbar>div{gap:9px}.plan-toolbar strong{font-size:11px}.plan-toolbar .button{font-size:10px;padding:10px 12px}.plan-ending{padding:30px 10px}.plan-picker-heading h2{font-size:26px}}
@media print{.site-header,.site-footer,.plan-picker,.plan-toolbar>div,.plan-day-actions,.plan-item-remove,.plan-ending,dialog,.toast{display:none!important}.plan-workspace{display:block;padding:0}.container{width:100%}.page-intro{padding:20px 0}.plan-day{break-inside:avoid}.plan-notes{border:none!important}}
</style>
