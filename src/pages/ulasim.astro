---
import Layout from '../layouts/Layout.astro';
import Transport from '../components/Transport.astro';
import { getLocale } from '../lib/i18n';
import { ui } from '../lib/ui';
const locale=getLocale(Astro.url.pathname), t=ui(locale);
---
<Layout title={t('Datça ulaşım ve sefer saatleri')} description={t('Dalaman Havalimanı için Havaş ve MUTTAŞ servisleri, Datça dolmuşları ve Bodrum feribotu. Hat, kalkış yönü ve seyahat gününe göre saatleri incele.')}><Transport locale={locale}/></Layout>
