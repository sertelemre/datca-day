---
import { ui } from '../lib/ui';
import { getLocale, localePath } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = ui(locale);
const localize = (path: string) => localePath(path, locale);

import Layout from '../layouts/Layout.astro';
import CategoryListing from '../components/CategoryListing.astro';
import TopicDirectory from '../components/TopicDirectory.astro';
import { getContent } from '../lib/i18n';
const content = getContent(locale);
const articles = content.articles.filter(article => !article.noindex && !article.canonicalPath);
const categories = content.categories;
const {noindex=false}=Astro.props;
const category={id:0,name:t("Datça’yı keşfet"),slug:"rehber",path:localize('/rehber'),description:t('Denizden doğaya, küçük kasabalardan güzel anılara. Datça hakkında merak ettiğin her şey, yerinden notlarla burada.'),parent:0,count:articles.length};
---
<Layout title={t("Datça gezi rehberleri: bütün rotalar ve konular")} description={category.description} noindex={noindex} canonicalPath="/rehber"><CategoryListing category={category} articles={articles} subcategories={categories.filter(c=>c.count>0)}><div slot="guide-navigation" class="detail-container"><a class="guide-search-jump" href="#category-search">{t("Rehberlerde ara")} ↓</a><TopicDirectory compact/></div></CategoryListing><section class="event-search-page" data-event-search-page hidden aria-labelledby="event-search-heading"><h2 id="event-search-heading">{t('Etkinlikler ve sefer saatleri')}</h2><p data-event-search-summary hidden></p><div class="event-search-page-list" data-event-search-results aria-live="polite"></div><p data-event-search-empty hidden>{t('Bu aramada etkinlik veya hat bulunamadı.')}</p><a class="text-link" href={localize('/etkinlikler')}>{t('Etkinlik takvimine bak')} →</a></section><noscript><p class="detail-container event-search-noscript"><a href={localize('/etkinlikler')}>{t('Etkinlik takvimine bak')} →</a></p></noscript></Layout>
<style>.event-search-page{border:1px solid var(--line);border-radius:6px;background:var(--cream);padding:23px 25px;margin:20px 0 28px}.event-search-page h2{font-size:29px;margin-bottom:7px}.event-search-page>p{font-size:14px;line-height:1.8;color:var(--muted);margin:16px 0}.event-search-page>.text-link{margin-top:17px;font-size:14px}.event-search-page-list :global(.search-result){align-items:flex-start}.event-search-page-list :global(.search-result strong){font-size:24px}.event-search-page-list :global(.search-result small){font-size:13px}.event-search-page-list :global(.search-result:last-child){border-bottom:0}.event-search-noscript{padding-bottom:25px;font-size:14px}@media(max-width:560px){.event-search-page{padding:20px}.event-search-page h2{font-size:27px}}</style>

<style>.guide-search-jump{display:inline-flex;align-items:center;min-height:44px;margin-top:22px;padding:8px 14px;border:1px solid var(--line);border-radius:5px;color:var(--green);font-size:14px}</style>
