---
import { ui } from '../lib/ui';
import { getLocale, localePath } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = ui(locale);
const localize = (path: string) => localePath(path, locale);

import Layout from '../layouts/Layout.astro';
---
<Layout title={t("datca.day hakkında ve yayın ilkeleri")} description={t("datca.day’in özgün içerik, resmî kaynak kontrolü, fotoğraf lisansları ve güncelleme yaklaşımını öğren. Bağımsız Datça gezi rehberi.")}><section class="container section editorial-page"><span class="eyebrow">{t("BİR GÜN DE DATÇA")}</span><h1>{t("Rotanı kurarken")}<br/><em>{t("iyi bilgiye yer aç.")}</em></h1><p class="lead">{t("datca.day, Datça’yı keşfetmek ve kendi tatilini planlamak için hazırlanmış bağımsız bir gezi rehberidir.")}</p><h2>{t("Özgün bir gezi defteri")}</h2><p>{t("Her rehber kendi arama amacı için yeniden yazılır. Koy ziyaretini tekne paketinden, günlük hava tahminini iklim bilgisinden, konaklama bölgesini yemek paketinden ayırırız. Amacımız aynı cümleleri birçok sayfaya dağıtmak yerine gerçek bir karar vermene yardımcı olmaktır.")}</p><h2>{t("Değişen bilgiler için doğrudan kaynak")}</h2><p>{t("Sefer, ücret, nöbet, etkinlik ve işletme düzeni değişebilir. Rehberlerde kontrol edilen resmî kaynaklara bağlantı ve son içerik inceleme tarihi bulunur. Seyahat tarihinde işletmeci veya ilgili kurumdan güncel koşulu öğrenmelisin. Bir yerin fotoğrafını göstermek, bugün açık olduğunu garanti etmez.")}</p><h2>{t("Gerçek yerler, açık fotoğraf kayıtları")}</h2><p>{t("Fotoğraflar bağımsız kaynaklardan seçilir; gerçek konumları, yazarları ve kullanım lisansları kaydedilir. Özel bir işletmeye ait olmayan bölge fotoğrafını o işletmenin görüntüsü olarak etiketlemeyiz.")} <a href={localize("/fotograf-kaynaklari")}>{t("Fotoğraf kaynakları")}</a> {t("sayfası yazar ve lisans bilgilerini listeler.")}</p><h2>{t("Kendi planın, kendi tarayıcın")}</h2><p>{t("Kaydettiğin yerler ve günlük planın tarayıcında saklanır. Burada otel, tur veya feribot satışı yapılmaz; rehber seni ilgili sağlayıcının güncel kanalına yönlendirir. Bütçe aracı da senin girdiğin tutarları hesaplar. Kayıtlarla ilgili ayrıntılar")} <a href={localize("/gizlilik")}>{t("gizlilik sayfasında")}</a> {t("açıklanır.")}</p><h2>{t("Düzeltmelerin yeri var")}</h2><p>{t("Bir bilgi değişmişse sayfa bağlantısı ve doğrulanabilir bir kaynakla öneri paylaşabilirsin.")} <a href={localize("/iletisim")}>{t("Öneri ve düzeltme kanalı")}</a> {t("rehberin güncellenmesi için açıktır.")}</p></section></Layout>
<style>.editorial-page{max-width:850px}.editorial-page h1{font-size:clamp(45px,7vw,72px);margin:20px 0 28px;line-height:1.05}.editorial-page .lead{font-size:19px}.editorial-page h2{font-size:34px;margin:34px 0 14px}.editorial-page p{color:var(--muted);font-size:14px;line-height:1.9}.editorial-page a{color:var(--orange);text-decoration:underline}</style>
