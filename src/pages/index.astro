---
import { ui } from '../lib/ui';
import { getLocale, localePath } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = ui(locale);
const localize = (path: string) => localePath(path, locale);

import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Card from '../components/Card.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import TopicDirectory from '../components/TopicDirectory.astro';
import { findArticle, findCategory } from '../lib/content';
import { getContent } from '../lib/i18n';
const { articles } = getContent(locale);
const categoryPath = (slug:string) => findCategory(slug, locale)?.path || localize('/rehber');
const bySlugs = (slugs:string[]) => slugs.map(slug => findArticle(slug, locale)).filter(Boolean) as typeof articles;
const destinations = bySlugs(['eski-datca','palamutbuku','hayitbuku','ovabuku']);
const experiences = bySlugs(['datca-tekne-turu','bodrum-datca-feribotu','karya-yolu']);
const tripGuides = bySlugs(['datcada-uc-gun','cocuklarla-datca','sezon-disinda-datca']);
const guides = bySlugs(['knidos-antik-kenti','kizlan-yel-degirmenleri','datca-kamp-rehberi']);
const beach = findArticle('ovabuku', locale);
const names = [t('Eski Datça'),'Palamutbükü','Hayıtbükü','Ovabükü'];
const menu = [
 {icon:'pin',name:'Tatil yerleri',sub:'Yeni bir rota bul',slug:'datca-cevresi'},
 {icon:'waves',name:'Koylar & plajlar',sub:'Maviye doğru',slug:'datca-koylari'},
 {icon:'boat',name:'Turlar & aktiviteler',sub:'Günü dolu dolu yaşa',slug:'gunluk-turlar'},
 {icon:'tent',name:'Doğa & kamp',sub:'Biraz yavaşla',slug:'datca-orman-kamplari'},
 {icon:'bed',name:"Konaklama",sub:'Kendine bir yer bul',path:'/datcada-nerede-kalinir'},
];
---
<Layout title={t("Datça Tatil Rehberi: Koylar, Turlar ve Yerel Bilgiler")} description={t("Datça’yı yerinden keşfet. Saklı koylar, güzel kasabalar, tekne turları ve tatilini kolaylaştıran yerel rehberler.")}>
 <section class="home-hero">
  <div class="hero-image"><img src="/images/hero-datca.webp" srcset="/images/hero-datca-640.webp 640w, /images/hero-datca.webp 1650w" sizes="100vw" alt={t("Knidos kıyısında turkuaz bir koy")} width="1600" height="695" fetchpriority="high"/><div class="hero-shade"></div></div>
  <div class="hero-content container"><span class="hero-eyebrow"><span></span> {t("DATÇA’NIN TATİL KAPISI")}</span><h1>{t("Datça’yı")}<br/><em>{t("keşfet.")}</em></h1><p>{t("Saklı koylar, sıcacık kasabalar, hiç bitmesin dediğin günler.")}<br class="desktop-break"/> {t("Kıyı rotaları ve güncel bilgilerle kendi tatilini kur.")}</p><a href="#kesfet" class="button button-light">{t("Datça’yı keşfet")} <Icon name="arrow" size={19}/></a></div>
  <div class="hero-bottom container"><div class="hero-location"><Icon name="pin" size={18}/><span>{t("Datça, Muğla")}<br/><small>{t("Ege ile Akdeniz’in buluştuğu yer")}</small></span></div><a href="#kesfet" class="hero-scroll">{t("KEŞFETMEYE DEVAM ET")} <span>↓</span></a><span class="hero-note">{t("Her mevsim başka güzel.")}</span></div>
  <div class="hero-stamp"><span>{t("DENİZ • DOĞA • KEŞİF")}</span><Icon name="sun" size={34}/><small>DATCA.DAY</small></div>
 </section>
 <nav class="mobile-shortcuts container" aria-label={t('Günlük bilgiler')}><a href={localize('/ulasim')}><Icon name="compass" size={18}/>{t('Sefer saatleri')}</a><a href={localize('/etkinlikler')}><Icon name="calendar" size={18}/>{t('Etkinlikler')}</a><a href={localize('/datca-hava-durumu')}><Icon name="sun" size={18}/>{t('Hava durumu')}</a></nav>
 <section class="quick-explore container" aria-label={t("Tatil kategorileri")}>{menu.map(item=><a href={item.path ? localize(item.path) : categoryPath(item.slug!)}><span class="quick-icon"><Icon name={item.icon} size={27}/></span><span><strong>{t(item.name)}</strong><small>{t(item.sub)}</small></span><Icon name="arrow" size={16}/></a>)}</section>
 <div class="home-today container"><WeatherWidget compact/><section class="home-events"><span class="home-events-icon"><Icon name="calendar" size={29}/></span><div><span class="eyebrow">{t('DATÇA’DA BİR ARAYA GELELİM')}</span><h2>{t('Datça’da neler oluyor?')}</h2><p>{t('Konser, tiyatro, sinema ve yerel etkinlikler. Duyuruları kaynaklarıyla birlikte keşfet.')}</p><a class="text-link" href={localize('/etkinlikler')}>{t('Etkinlik takvimine bak')} <Icon name="arrow" size={18}/></a></div></section></div>
 <section class="section container" id="kesfet">
  <div class="section-heading"><div><span class="eyebrow"><span class="tiny-line"></span> {t("HER KÖŞESİ AYRI BİR HİKÂYE")}</span><h2>{t("Bir yer seç.")}<br class="mobile-break"/> <em>{t("Kendini bul.")}</em></h2></div><a class="text-link" href={categoryPath('datca-cevresi')}>{t("Tüm tatil yerleri")} <Icon name="arrow" size={18}/></a></div>
  <p class="section-intro">{t("Kalabalıktan uzak bir koy mu, sahilde uzun bir akşam mı?")}<br/>{t("Sana iyi gelecek bir Datça mutlaka var.")}</p>
  <div class="destination-grid">{destinations.map((article,index)=><article class="destination-card"><a href={article.path}><img src={article.image} alt={article.imageAlt || article.title} width="500" height="650" loading="lazy"/><div class="destination-shade"></div><span class="destination-number">0{index+1}</span><div class="destination-copy"><span>{t(['HUZURUN ADRESİ','MAVİNİN EN GÜZELİ','DENİZLE İÇ İÇE','KIYIDA BİR MOLA'][index])}</span><h3>{names[index]}</h3><p>{t(['Yavaş günler, uzun akşamlar.','Bir koydan çok daha fazlası.','Denize açılan küçük sokaklar.','Deniz, güneş ve sen.'][index])}</p></div><span class="destination-arrow"><Icon name="arrow" size={21}/></span></a><button class="save-button" data-save={article.path} data-title={article.title} data-image={article.image} aria-label={t("{title} kaydet", {title: article.title})} aria-pressed="false"><Icon name="heart" size={18}/></button></article>)}</div>
 </section>
 <section class="experience-section"><div class="container section"><div class="section-heading"><div><span class="eyebrow"><span class="tiny-line"></span> {t("TATİLİNE BİR HİKÂYE EKLE")}</span><h2>{t("Günler geçsin.")}<br/><em>{t("Anılar kalsın.")}</em></h2></div><div class="heading-right"><p>{t("Denize açıl, yeni yollar bul, ilk kez bir şey dene.")}<br/>{t("Datça’da her gün başka bir keşif.")}</p><a class="text-link" href={categoryPath('gunluk-turlar')}>{t("Tüm turlar & aktiviteler")} <Icon name="arrow" size={18}/></a></div></div><div class="card-grid">{experiences.map(article=><Card article={article}/>)}</div><a href={localize("/bodrum-datca-feribotu")} class="ferry-strip"><span class="ferry-icon"><Icon name="boat" size={28}/></span><span><strong>{t("Bodrum’a denizden gidelim mi?")}</strong><small>{t("Feribot seferlerini keşfet, tatiline başka bir kıyı ekle.")}</small></span><span class="text-link">{t("Bodrum feribotu")} <Icon name="external" size={17}/></span></a></div></section>
 <section class="slow-section container section"><div class="slow-image"><img src={beach?.image || '/images/hero-datca.webp'} alt={beach?.imageAlt || t('Datça kıyı manzarası')} width="800" height="800" loading="lazy"/><div class="slow-photo-note"><Icon name="waves" size={19}/> {t("MAVİYE BİRAZ DAHA YAKIN")}</div><span class="photo-corner">{t("OVABÜKÜ · MESUDİYE")}</span></div><div class="slow-copy"><span class="eyebrow"><span class="tiny-line"></span> {t("ACELE ETME. TATİLDESİN.")}</span><h2>{t("Bazı yerler")}<br/>{t("sadece")} <em>{t("iyi gelir.")}</em></h2><p>{t("Çam kokusu denize karışır. Sabahlar usulca başlar. Bir koyda zamanın nasıl geçtiğini unutursun.")}</p><p>{t("Datça’nın koyları ve plajları, tam da böyle günler için. Havlunu al, kendine bir yer bul. Gerisini maviye bırak.")}</p><a class="button" href={categoryPath('datca-koylari')}>{t("Koyları & plajları keşfet")} <Icon name="arrow" size={18}/></a><div class="slow-tags"><span><Icon name="waves" size={17}/> {t("Turkuaz sular")}</span><span><Icon name="leaf" size={17}/> {t("Doğanın içinde")}</span><span><Icon name="sun" size={17}/> {t("Sakin günler")}</span></div></div></section>
 <section class="section container guide-section"><div class="section-heading"><div><span class="eyebrow"><span class="tiny-line"></span> {t("GEZİ DEFTERİNDEN NOTLAR")}</span><h2>{t("Gitmeden önce")} <em>{t("bir göz at.")}</em></h2></div><a class="text-link" href={localize("/rehber")}>{t("Tüm rehberler")} <Icon name="arrow" size={18}/></a></div><div class="card-grid">{guides.map(article=><Card article={article} variant="guide"/>)}</div></section>
 <section class="practical-strip container"><div><span class="eyebrow">{t("KÜÇÜK BİLGİLER, RAHAT BİR TATİL")}</span><h3>{t("Aklındaki sorulara")}<br/>{t("yerinden cevaplar.")}</h3></div>{[{icon:'compass',title:'Nasıl gelirim?',text:'Servis ve otobüs saatleri',path:'/ulasim'},{icon:'bed',title:'Nerede kalırım?',text:'Konaklama seçenekleri',path:'/datcada-nerede-kalinir'},{icon:'utensils',title:'Ne kadar harcarım?',text:'Yiyecek ve içecek rehberi',path:'/datcada-ne-yenir'}].map(item=><a href={localize(item.path)}><Icon name={item.icon} size={28}/><strong>{t(item.title)}</strong><span>{t(item.text)}</span><Icon name="arrow" size={17}/></a>)}</section>
 <section class="section container"><div class="section-heading"><div><span class="eyebrow">{t("SANA UYAN BİR TEMPO")}</span><h2>{t("Rotanı")} <em>{t("kendine göre kur.")}</em></h2></div><a class="text-link" href={localize("/rehber")}>{t("Bütün planlama rehberleri")} <Icon name="arrow" size={18}/></a></div><div class="card-grid">{tripGuides.map(article=><Card article={article} variant="guide"/>)}</div></section>
 <section class="container section"><TopicDirectory compact/></section>
 <section class="planner-banner"><div class="container planner-inner"><span class="planner-doodle"><Icon name="sun" size={95}/></span><div><span class="eyebrow">{t("BU TATİL SENİN HİKÂYEN")}</span><h2>{t("Biraz hayal et.")}<br/><em>{t("Birlikte planlayalım.")}</em></h2><p>{t("Sevdiğin yerleri kaydet, günlerini planla.")}<br/>{t("Datça’da sana ait bir rota oluştur.")}</p><a class="button button-light" href={localize("/tatil-planim")}>{t("Tatilimi planla")} <Icon name="arrow" size={18}/></a></div><div class="planner-visual"><span class="planner-paper"><span class="eyebrow">{t("BENİM DATÇA’M")}</span><h3>{t("Deniz. Keşif.")}<br/>{t("Biraz da huzur.")}</h3><span><Icon name="check" size={16}/> {t("Bir koyda yüz")}</span><span><Icon name="check" size={16}/> {t("Yeni bir yer keşfet")}</span><span><Icon name="check" size={16}/> {t("Gün batımını yakala")}</span><small>{t("Gerisini yolda buluruz. ✺")}</small></span><img src="/images/palamutbuku.webp" alt={t("Palamutbükü kıyısı")} width="360" height="420" loading="lazy"/></div></div></section>
</Layout>
<style>.home-today{display:grid;grid-template-columns:minmax(280px,350px) 1fr;gap:20px;margin-top:24px}.home-events{border:1px solid var(--line);border-radius:12px;background:var(--paper);padding:25px 30px;display:flex;align-items:center;gap:23px}.home-events-icon{color:var(--orange);flex-shrink:0}.home-events h2{font-size:30px;margin:8px 0 7px}.home-events p{font-size:14px;line-height:1.7;color:var(--muted)}.home-events .text-link{margin-top:18px;font-size:13px}.home-events .eyebrow{font-size:11px}@media(max-width:900px){.home-today{grid-template-columns:minmax(250px,.85fr) 1fr;gap:16px}.home-events{padding:22px;gap:15px}.home-events-icon{display:none}.home-events h2{font-size:29px}}@media(max-width:600px){.home-today{grid-template-columns:minmax(0,1fr);margin-top:20px;gap:15px}.home-events{padding:22px;gap:16px;align-items:flex-start}.home-events h2{font-size:27px}.home-events-icon{display:block;margin-top:5px}.home-events .eyebrow{font-size:10px}}@media(max-width:360px){.home-events{padding:18px;gap:10px}.home-events-icon{display:none}.home-events h2{overflow-wrap:anywhere}}</style>
